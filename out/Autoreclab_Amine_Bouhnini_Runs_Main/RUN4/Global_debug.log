 [1, 2, 3, 4, 5, 11, 13, 17, 19, 23]\\nK = 10\\n\\nexperiment_data = {\\n    \'movielens100k\': {\\n        \'metrics\': {\'train\': [], \'val\': []},\\n        \'losses\': {\'train\': [], \'val\': []},\\n        \'predictions\': [],\\n        \'ground_truth\': [],\\n        \'seeds\': [],\\n        \'recall_at_k\': [],\\n        \'ndcg_at_k\': [],\\n    },\\n}\\n\\n# -----------------------------\\n# Load data\\n# -----------------------------\\ncols = [\'user\', \'item\', \'rating\', \'timestamp\']\\nratings = pd.read_csv(DATA_FILE, sep=\'\\\\t\', names=cols, engine=\'python\')\\nratings[\'user\'] = ratings[\'user\'].astype(int)\\nratings[\'item\'] = ratings[\'item\'].astype(int)\\nratings[\'rating\'] = ratings[\'rating\'].astype(float)\\n\\n# Normalize ratings for MF input while preserving positives; use implicit feedback style\\n# LensKit\'s ImplicitMF expects a user-item interaction table; we weight by scaled ratings.\\nratings[\'rating_norm\'] = (ratings[\'rating\'] - ratings[\'rating\'].min()) / (ratings[\'rating\'].max() - ratings[\'rating\'].min())\\nratings[\'rating_norm\'] = ratings[\'rating_norm\'].clip(lower=1e-6)\\ninteractions = ratings[[\'user\', \'item\', \'rating_norm\']].rename(columns={\'rating_norm\': \'rating\'})\\n\\n# -----------------------------\\n# Split by user to avoid cold-start in evaluation\\n# -----------------------------\\ndef split_userwise(df, test_size=0.2, seed=42):\\n    train_parts = []\\n    test_parts = []\\n    rng = np.random.RandomState(seed)\\n    for uid, grp in df.groupby(\'user\'):\\n        if len(grp) < 2:\\n            train_parts.append(grp)\\n            continue\\n        tr, te = train_test_split(grp, test_size=test_size, random_state=rng.randint(0, 2**31 - 1))\\n        train_parts.append(tr)\\n        test_parts.append(te)\\n    return pd.concat(train_parts, ignore_index=True), pd.concat(test_parts, ignore_index=True)\\n\\ntrain, test = split_userwise(interactions, TEST_SIZE, RANDOM_STATE_SPLIT)\\n\\n# Hold out only users/items seen in train for clean ranking evaluation\\ntrain_users = set(train[\'user\'].unique())\\ntrain_items = set(train[\'item\'].unique())\\ntest = test[test[\'user\'].isin(train_users) & test[\'item\'].isin(train_items)].copy()\\n\\n# Ground truth items per user\\ntruth = test.groupby(\'user\')[\'item\'].apply(list).to_dict()\\n\\n# -----------------------------\\n# Evaluation helper\\n# -----------------------------\\ndef evaluate_model(model, train_df, truth_dict, k=10):\\n    users = sorted(truth_dict.keys())\\n    # Recommend top-k for each user; exclude seen items via candidate generation from LensKit\\n    recs = batch.recommend(model, users, k=k, n_jobs=1)\\n    # Ensure required columns\\n    recs = recs[[\'user\', \'item\', \'rank\', \'score\']].copy()\\n    recs = recs.sort_values([\'user\', \'rank\'])\\n    # Build LensKit recommendation lists for metric functions\\n    recs_by_user = defaultdict(list)\\n    for row in recs.itertuples(index=False):\\n        recs_by_user[row.user].append((row.item, row.score))\\n\\n    rec_frames = []\\n    for u, items in recs_by_user.items():\\n        rec_frames.append(pd.DataFrame({\'user\': u, \'item\': [it for it, _ in items], \'rank\': np.arange(1, len(items) + 1)}))\\n    rec_df = pd.concat(rec_frames, ignore_index=True) if rec_frames else pd.DataFrame(columns=[\'user\', \'item\', \'rank\'])\\n\\n    truth_rows = []\\n    for u, items in truth_dict.items():\\n        for it in items:\\n            truth_rows.append({\'user\': u, \'item\': it})\\n    truth_df = pd.DataFrame(truth_rows)\\n\\n    # LensKit metrics\\n    r = recall(rec_df, truth_df, k=k)\\n    n = ndcg(rec_df, truth_df, k=k)\\n    return rec_df, truth_df, float(r), float(n)\\n\\n# -----------------------------\\n# Train multiple seeds\\n# -----------------------------\\nfor seed in SEEDS:\\n    model = ImplicitMF(features=30, iterations=20, reg=0.1, random_state=seed)\\n    model.fit(train)\\n    rec_df, truth_df, rec_at_k, ndcg_at_k = evaluate_model(model, train, truth, k=K)\\n\\n    experiment_data[\'movielens100k\'][\'seeds\'].append(seed)\\n    experiment_data[\'movielens100k\'][\'recall_at_k\'].append(rec_at_k)\\n    experiment_data[\'movielens100k\'][\'ndcg_at_k\'].append(ndcg_at_k)\\n    experiment_data[\'movielens100k\'][\'predictions\'].append(rec_df[[\'user\', \'item\', \'rank\']].to_numpy())\\n    experiment_data[\'movielens100k\'][\'ground_truth\'].append(truth_df[[\'user\', \'item\']].to_numpy())\\n    experiment_data[\'movielens100k\'][\'metrics\'][\'val\'].append({\'seed\': seed, \'recall@10\': rec_at_k, \'ndcg@10\': ndcg_at_k})\\n    print(f\'Epoch {seed}: validation_loss = {np.nan:.4f}\')\\n    print(f\'Seed {seed}: Recall@{K}={rec_at_k:.4f}, NDCG@{K}={ndcg_at_k:.4f}\')\\n\\n# -----------------------------\\n# Aggregate and save\\n# -----------------------------\\nrecalls = np.array(experiment_data[\'movielens100k\'][\'recall_at_k\'], dtype=float)\\nndcgs = np.array(experiment_data[\'movielens100k\'][\'ndcg_at_k\'], dtype=float)\\n\\nsummary = {\\n    \'recall_mean\': recalls.mean(),\\n    \'recall_std\': recalls.std(ddof=1) if len(recalls) > 1 else 0.0,\\n    \'ndcg_mean\': ndcgs.mean(),\\n    \'ndcg_std\': ndcgs.std(ddof=1) if len(ndcgs) > 1 else 0.0,\\n}\\n\\nprint(\'\\\\nSummary over seeds:\')\\nprint(f\\"Recall@{K}: mean={summary[\'recall_mean\']:.4f}, std={summary[\'recall_std\']:.4f}\\")\\nprint(f\\"NDCG@{K}:   mean={summary[\'ndcg_mean\']:.4f}, std={summary[\'ndcg_std\']:.4f}\\")\\n\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\\nnp.save(os.path.join(working_dir, \'movielens100k_recall_at_10.npy\'), recalls)\\nnp.save(os.path.join(working_dir, \'movielens100k_ndcg_at_10.npy\'), ndcgs)\\nnp.save(os.path.join(working_dir, \'movielens100k_seed_list.npy\'), np.array(SEEDS))\\nnp.save(os.path.join(working_dir, \'movielens100k_summary.npy\'), np.array([summary[\'recall_mean\'], summary[\'recall_std\'], summary[\'ndcg_mean\'], summary[\'ndcg_std\']]))\\n\\n# -----------------------------\\n# Plot\\n# -----------------------------\\nplt.figure(figsize=(8, 4))\\nxs = np.arange(len(SEEDS))\\nplt.plot(xs, recalls, marker=\'o\', label=f\'Recall@{K}\')\\nplt.plot(xs, ndcgs, marker=\'s\', label=f\'NDCG@{K}\')\\nplt.xticks(xs, SEEDS, rotation=45)\\nplt.xlabel(\'Random seed\')\\nplt.ylabel(\'Metric value\')\\nplt.title(\'LensKit ImplicitMF seed sensitivity on MovieLens100K\')\\nplt.legend()\\nplt.tight_layout()\\nplot_path = os.path.join(working_dir, \'movielens100k_seed_sensitivity.png\')\\nplt.savefig(plot_path, dpi=150)\\nplt.close()\\n\\n# Also save a compact table for convenience\\nresults_df = pd.DataFrame({\'seed\': SEEDS, f\'recall@{K}\': recalls, f\'ndcg@{K}\': ndcgs})\\nresults_df.to_csv(os.path.join(working_dir, \'movielens100k_seed_sensitivity.csv\'), index=False)\\nprint(f\'Plot saved to: {plot_path}\')"}', name='return_plan_and_code'), type='function')]))[/cyan]
