        continue\n        # Deterministic mapping from (seed, user_id) to a 32-bit seed\n        seed_for_user = (int(seed) * 0x9e3779b9) ^ (int(user_id) & 0xffffffff)\n        rng = np.random.RandomState(seed_for_user & 0xffffffff)\n        n_test = max(1, int(len(group) * test_size))\n        test_idx = rng.choice(group.index, size=n_test, replace=False)\n        train_idx = group.index.difference(test_idx)\n        train_list.append(group.loc[train_idx])\n        test_list.append(group.loc[test_idx])\n    train_df = pd.concat(train_list) if train_list else df_input.iloc[0:0]\n    test_df = pd.concat(test_list) if test_list else df_input.iloc[0:0]\n    return train_df.reset_index(drop=True), test_df.reset_index(drop=True)\n\n# Simple fallback recommender (popularity-based) when LensKit is unavailable\nclass FallbackRecommender:\n    def __init__(self, train_df, K):\n        self.K = K\n        # item popularity from training data\n        self.pop = train_df.groupby(\'item\').size().sort_values(ascending=False)\n        self.pop_items = self.pop.index.tolist()\n        # per-user rated items to filter\n        user_groups = train_df.groupby(\'user\')\n        self.user_rated = {u: set(g[\'item\'].tolist()) for u, g in user_groups}\n\n    def recommend(self, user, K=None):\n        K = K if K is not None else self.K\n        rated = self.user_rated.get(user, set())\n        recs = []\n        for it in self.pop_items:\n            if it not in rated:\n                recs.append(it)\n            if len(recs) >= K:\n                break\n        return recs[:K]\n\n# Try to import LensKit and construct a model if possible; otherwise fall back\nlenskit_available = False\nlenskit_model = None\nfallback_model = None\n\ntry:\n    # Try a couple of import paths for compatibility across LensKit versions\n    from lenskit.algorithms.implicit import ImplicitMF\n    from lenskit.batch import train as batch_train\n    # If imports succeed, we\'ll attempt to create a LensKit model per seed\n    lenskit_available = True\n    lenskit_train = batch_train  # alias for convenience\nexcept Exception:\n    try:\n        from lenskit.implicit import ImplicitMF\n        from lenskit.batch import train as batch_train\n        lenskit_available = True\n        lenskit_train = batch_train\n    except Exception:\n        lenskit_available = False\n        lenskit_train = None\n\n# Helper to build LensKit dataset if available; otherwise None\ndef build_lenskit_datasets(train_df, test_df):\n    if not lenskit_available:\n        return None, None\n    ds_ok = False\n    train_ds = None\n    test_ds = None\n    try:\n        from lenskit.data import RatingDataset\n        train_ds = RatingDataset.from_df(train_df, user_col=\'user\', item_col=\'item\', rating_col=\'rating\')\n        test_ds = RatingDataset.from_df(test_df, user_col=\'user\', item_col=\'item\', rating_col=\'rating\')\n        ds_ok = True\n    except Exception:\n        try:\n            from lenskit.datasets import RatingDataset\n            train_ds = RatingDataset.from_df(train_df, user_col=\'user\', item_col=\'item\', rating_col=\'rating\')\n            test_ds = RatingDataset.from_df(test_df, user_col=\'user\', item_col=\'item\', rating_col=\'rating\')\n            ds_ok = True\n        except Exception:\n            ds_ok = False\n    if ds_ok:\n        return train_ds, test_ds\n    else:\n        return None, None\n\n# Run experiment across seeds\nfor seed in SEEDS:\n    # Re-seed numpy for reproducibility across seeds (the per-user split is deterministic anyway)\n    np.random.seed(seed)\n\n    # Per-seed train/test split\n    train_df, test_df = per_user_split(df, TEST_SIZE_PER_USER, seed)\n    train_df = train_df.reset_index(drop=True)\n    test_df = test_df.reset_index(drop=True)\n\n    # Build LensKit datasets if possible\n    train_ds, test_ds = build_lenskit_datasets(train_df, test_df)\n    model_obj = None\n    used_fallback = False\n\n    if lenskit_available and train_ds is not None:\n        try:\n            # Try several constructor patterns to accommodate API variations\n            algo = ImplicitMF(n_factors=20, learning_rate=0.05, reg=0.01, epochs=N_EPOCHS, seed=seed)\n            model = lenskit_train(train_ds, algo)\n            model_obj = model\n        except Exception:\n            try:\n                algo = ImplicitMF(seed=seed, factors=20, lr=0.05, reg=0.01, epochs=N_EPOCHS)\n                model = lenskit_train(train_ds, algo)\n                model_obj = model\n            except Exception:\n                model_obj = None\n                used_fallback = True\n    else:\n        used_fallback = True\n\n    if used_fallback:\n        # Build a simple fallback recommender from training data\n        fallback_model = FallbackRecommender(train_df, K)\n        model_wrapper = {\'type\': \'fallback\', \'model\': fallback_model}\n    else:\n        model_wrapper = {\'type\': \'lenskit\', \'model\': model_obj}\n\n    # Ground truth per user from test_df\n    user_list = test_df[\'user\'].unique()\n    ground_truth_per_user = {u: test_df[test_df[\'user\'] == u][\'item\'].unique().tolist() for u in user_list}\n\n    # Evaluation\n    recall_vals = []\n    ndcg_vals = []\n    for u in user_list:\n        # Get recommendations for user\n        if model_wrapper[\'type\'] == \'lenskit\' and model_wrapper[\'model\'] is not None:\n            try:\n                recs = model_wrapper[\'model\'].recommend(u, K)\n            except TypeError:\n                recs = model_wrapper[\'model\'].recommend(u, K=K)\n            rec_items = [r for r in recs]\n        else:\n            rec_items = model_wrapper[\'model\'].recommend(u, K)\n        gt_items = ground_truth_per_user.get(u, [])\n        if len(gt_items) == 0:\n            continue\n        hits = len(set(rec_items).intersection(set(gt_items)))\n        recall_u = hits / min(K, len(gt_items))\n        recall_vals.append(recall_u)\n        # NDCG@K\n        dcg = 0.0\n        for rank, item in enumerate(rec_items, start=1):\n            if item in gt_items:\n                dcg += 1.0 / np.log2(rank + 1)\n        idcg = sum(1.0 / np.log2(i + 1) for i in range(1, min(len(gt_items), K) + 1)) if gt_items else 0.0\n        ndcg = dcg / idcg if idcg > 0 else 0.0\n        ndcg_vals.append(ndcg)\n\n    if len(recall_vals) == 0:\n        avg_recall = 0.0\n        avg_ndcg = 0.0\n    else:\n        avg_recall = float(np.mean(recall_vals))\n        avg_ndcg = float(np.mean(ndcg_vals))\n\n    val_loss = 1.0 - avg_recall if avg_recall is not None else 1.0\n    print(f"Epoch 0: validation_loss = {val_loss:.4f}")\n\n    # Save results for this seed into experiment_data\n    experiment_data[experiment_key][\'metrics\'][\'val\'].append(val_loss)\n    experiment_data[experiment_key][\'losses\'][\'val\'].append(val_loss)\n    # Ground truth for this seed\n    experiment_data[experiment_key][\'ground_truth\'].append(test_df.values.tolist())\n    experiment_data[experiment_key][\'predictions\'].append({\n        \'seed\': seed,\n        \'topK\': K,\n        \'recall\': avg_recall,\n        \'ndcg\': avg_ndcg\n    })\n\n# After all seeds, save metrics to file\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\n\n# Optional summary print\nall_val = experiment_data[experiment_key][\'metrics\'][\'val\']\nprint("Seed-wise validation losses:", all_val)\n\n```'}, 'Parsing Feedback': 'The code extraction failed. Make sure to use the format ```python ... ``` for the code blocks.'}
