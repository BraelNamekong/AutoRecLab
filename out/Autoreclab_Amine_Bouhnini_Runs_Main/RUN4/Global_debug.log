ng\')\\nos.makedirs(working_dir, exist_ok=True)\\n\\n# Data loading\\nDATA_PATH = os.path.join(os.getcwd(), \'u.data\')\\nif not os.path.exists(DATA_PATH):\\n    raise FileNotFoundError(\\"u.data not found in working directory. Please ensure MovieLens 100K u.data is present.\\")\\n\\n# Load MovieLens-100K (user, item, rating, timestamp)\\ndf = pd.read_csv(DATA_PATH, sep=\'\\\\t\', header=None, names=[\'user\',\'item\',\'rating\',\'timestamp\'], engine=\'python\')\\ndf[\'user\'] = df[\'user\'].astype(int)\\ndf[\'item\'] = df[\'item\'].astype(int)\\ndf[\'rating\'] = df[\'rating\'].astype(float)\\ndf[\'timestamp\'] = df[\'timestamp\'].astype(int)\\n\\n# Normalize IDs to be 0-based for internal math (but keep for output if needed)\\ndf[\'user_id\'] = df[\'user\'] - 1\\ndf[\'item_id\'] = df[\'item\'] - 1\\nn_users = int(df[\'user_id\'].max()) + 1\\nn_items = int(df[\'item_id\'].max()) + 1\\n\\n# Convert to implicit interactions (we\'ll treat rating>=4 as positive interaction)\\ndf[\'interaction\'] = (df[\'rating\'] >= 4).astype(int)\\n# We will use the implicit-style data for training: for simplicity, we keep the rating as 1 for all interactions\\n\\ndef train_test_split_per_user(df, seed=0):\\n    rng = np.random.default_rng(seed)\\n    train_rows = []\\n    test_rows = []\\n    grouped = df.groupby(\'user_id\')\\n    for uid, group in grouped:\\n        if len(group) == 0:\\n            continue\\n        # choose 1 random interaction as test if available\\n        idxs = np.arange(len(group))\\n        test_idx = rng.choice(idxs, size=1, replace=False)\\n        # rest go to train\\n        for i, row in enumerate(group.itertuples(index=False)):\\n            if i in test_idx:\\n                test_rows.append(row._asdict())\\n            else:\\n                train_rows.append(row._asdict())\\n    train_df = pd.DataFrame(train_rows)\\n    test_df = pd.DataFrame(test_rows)\\n    if train_df.empty or test_df.empty:\\n        raise ValueError(\'Train or test set ended up empty. Adjust the splitting procedure.\')\\n    return train_df, test_df\\n\\n# Evaluation helpers: compute Recall@K and NDCG@K for ranked predictions\\n\\ndef recall_ndcg_at_k(preds_df, test_df, k=10):\\n    # preds_df: DataFrame with columns [\'user_id\',\'item_id\',\'score\'] for all user-item candidates\\n    # test_df: DataFrame with ground truth interactions (user_id,item_id) for test\\n    # Build per-user ground truth set\\n    test_by_user = test_df.groupby(\'user_id\')[\'item_id\'].apply(set).to_dict()\\n    # Build per-user predictions top-k\\n    topk = preds_df.sort_values([\'user_id\',\'score\'], ascending=[True, False]).groupby(\'user_id\').head(k)\\n    topk_by_user = topk.groupby(\'user_id\')[\'item_id\'].apply(list).to_dict()\\n    # Compute Recall@K and NDCG@K per user\\n    recalls = []\\n    ndcgs = []\\n    for u, gt in test_by_user.items():\\n        pred_list = topk_by_user.get(u, [])\\n        hit = sum(1 for x in pred_list if x in gt)\\n        rem = len(gt) if len(gt) > 0 else 1\\n        recalls.append(hit / min(len(gt), k))\\n        # DCG: sum over positions p of relevance(1 if item in gt else 0) / log2(p+1)\\n        dcg = 0.0\\n        for idx, item in enumerate(pred_list[:k], start=1):\\n            rel = 1 if item in gt else 0\\n            if rel:\\n                dcg += 1.0 / np.log2(idx + 1)\\n        idcg = sum(1.0 / np.log2(i + 1) for i in range(1, min(len(gt), k) + 1)) if len(gt) > 0 else 0.0\\n        ndcgs.append(dcg / idcg if idcg > 0 else 0.0)\\n    return np.mean(recalls), np.mean(ndcgs)\\n\\n# Try to use LensKit if available\\nlenskit_available = False\\ntry:\\n    from lenskit.algorithms.implicit import ImplicitMF\\n    from lenskit.batch import predict as lk_predict\\n    lenskit_available = True\\nexcept Exception:\\n    lenskit_available = False\\n\\n# Parameters\\nseeds = [0, 1, 2, 3, 4]  # multiple seeds to test\\nK = 10  # cutoff for recall/ndcg\\nresults = {\\n    \'seeds\': [],\\n    \'val_loss\': [],\\n  