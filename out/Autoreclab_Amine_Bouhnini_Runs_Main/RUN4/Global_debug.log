ray(recall_scores, dtype=float)\\nndcg_scores = np.array(ndcg_scores, dtype=float)\\n\\n# ---------- summarize ----------\\nprint(\'\\\\nSummary across seeds\')\\nprint(f\'Recall@{n_recs}: mean={np.nanmean(recall_scores):.4f}, std={np.nanstd(recall_scores):.4f}, min={np.nanmin(recall_scores):.4f}, max={np.nanmax(recall_scores):.4f}\')\\nprint(f\'NDCG@{n_recs}: mean={np.nanmean(ndcg_scores):.4f}, std={np.nanstd(ndcg_scores):.4f}, min={np.nanmin(ndcg_scores):.4f}, max={np.nanmax(ndcg_scores):.4f}\')\\n\\n# ---------- save arrays ----------\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\\nnp.save(os.path.join(working_dir, \'movielens100k_recall_at_10.npy\'), recall_scores)\\nnp.save(os.path.join(working_dir, \'movielens100k_ndcg_at_10.npy\'), ndcg_scores)\\n\\n# ---------- plot (optional) ----------\\nplot_path = os.path.join(working_dir, \'movielens100k_seed_sensitivity.png\')\\nif HAVE_MPL:\\n    plt.figure(figsize=(8, 4))\\n    plt.plot(seeds, recall_scores, marker=\'o\', label=f\'Recall@{n_recs}\')\\n    plt.plot(seeds, ndcg_scores, marker=\'s\', label=f\'NDCG@{n_recs}\')\\n    plt.xlabel(\'Random seed\')\\n    plt.ylabel(\'Metric value\')\\n    plt.title(\'Seed sensitivity on MovieLens100K with ImplicitMF\')\\n    plt.legend()\\n    plt.tight_layout()\\n    plt.savefig(plot_path, dpi=150)\\n    plt.close()\\n    print(f\'Plot saved to: {plot_path}\')\\nelse:\\n    print(\'matplotlib is not installed; skipping plot generation.\')\\n    print(f\'If needed, install matplotlib to save a plot at: {plot_path}\')\\n"}', name='return_plan_and_code'), type='function')]))[/cyan]
