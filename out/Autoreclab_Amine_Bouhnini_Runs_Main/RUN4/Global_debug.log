rt matplotlib.pyplot as plt\\nfrom lenskit.algorithms.als import ImplicitMF\\nfrom lenskit import batch, topn\\nfrom lenskit.algorithms import Recommender\\nfrom sklearn.model_selection import train_test_split\\n\\n# Reproducibility for data split only; model seeds vary intentionally.\\nGLOBAL_SPLIT_SEED = 2024\\nDATA_PATH = os.path.join(os.getcwd(), \'u.data\')\\nTOPK = 10\\nN_RUNS = 10\\nMODEL_SEEDS = list(range(1, N_RUNS + 1))\\nTEST_FRAC = 0.2\\nMIN_TEST_ITEMS = 1\\n\\nexperiment_data = {\\n    \'ml100k_u_data\': {\\n        \'metrics\': {\'train\': [], \'val\': []},\\n        \'losses\': {\'train\': [], \'val\': []},\\n        \'predictions\': [],\\n        \'ground_truth\': [],\\n        \'seeds\': [],\\n        \'timestamps\': []\\n    }\\n}\\n\\n# Load MovieLens100K u.data: user, item, rating, timestamp\\nratings = pd.read_csv(\\n    DATA_PATH,\\n    sep=\'\\\\t\',\\n    names=[\'user\', \'item\', \'rating\', \'timestamp\'],\\n    engine=\'python\'\\n)\\n\\n# Normalize to implicit feedback for ImplicitMF: one positive event per observed interaction.\\nratings = ratings[[\'user\', \'item\', \'rating\', \'timestamp\']].copy()\\nratings[\'rating\'] = 1.0\\n\\ntrain_df, test_df = train_test_split(\\n    ratings,\\n    test_size=TEST_FRAC,\\n    random_state=GLOBAL_SPLIT_SEED,\\n    shuffle=True\\n)\\n\\n# Keep only users appearing in train for recommendation; evaluate on their held-out positives.\\ntrain_users = set(train_df[\'user\'].unique())\\ntrain_items = set(train_df[\'item\'].unique())\\ntest_df = test_df[test_df[\'user\'].isin(train_users) & test_df[\'item\'].isin(train_items)].copy()\\n\\ntruth = test_df.groupby(\'user\')[\'item\'].apply(set)\\ntruth = truth[truth.apply(len) >= MIN_TEST_ITEMS]\\nusers = truth.index.to_numpy()\\n\\n# LensKit test set for top-N evaluation.\\ntest_pairs = pd.DataFrame({\\n    \'user\': np.repeat(list(truth.index), [len(s) for s in truth.values]),\\n    \'item\': np.concatenate([np.array(list(s)) for s in truth.values])\\n}) if len(truth) else pd.DataFrame(columns=[\'user\', \'item\'])\\n\\ndef recall_at_k(recs, truth_sets, k=10):\\n    vals = []\\n    for u, grp in recs.groupby(\'user\'):\\n        pred = grp.sort_values(\'rank\')[\'item\'].head(k).tolist()\\n        gt = truth_sets.get(u, set())\\n        if gt:\\n            vals.append(len(set(pred) & gt) / len(gt))\\n    return float(np.mean(vals)) if vals else 0.0\\n\\ndef ndcg_at_k(recs, truth_sets, k=10):\\n    vals = []\\n    for u, grp in recs.groupby(\'user\'):\\n        ranked = grp.sort_values(\'rank\')[\'item\'].head(k).tolist()\\n        gt = truth_sets.get(u, set())\\n        if not gt:\\n            continue\\n        dcg = 0.0\\n        for i, it in enumerate(ranked, start=1):\\n            if it in gt:\\n                dcg += 1.0 / np.log2(i + 1)\\n        ideal_hits = min(len(gt), k)\\n        idcg = sum(1.0 / np.log2(i + 1) for i in range(1, ideal_hits + 1))\\n        vals.append(dcg / idcg if idcg > 0 else 0.0)\\n    return float(np.mean(vals)) if vals else 0.0\\n\\nall_metrics = []\\nall_rec_counts = []\\ntruth_dict = truth.to_dict()\\n\\nfor run_idx, seed in enumerate(MODEL_SEEDS, start=1):\\n    algo = ImplicitMF(features=20, iterations=15, reg=0.1, weight=40, method=\'cg\', rng_spec=seed)\\n    algo = Recommender.adapt(algo)\\n    algo.fit(train_df[[\'user\', \'item\', \'rating\']])\\n\\n    recs = batch.recommend(algo, users, TOPK)\\n    recs = recs.sort_values([\'user\', \'rank\']).reset_index(drop=True)\\n\\n    rec10 = recall_at_k(recs, truth_dict, k=TOPK)\\n    ndcg10 = ndcg_at_k(recs, truth_dict, k=TOPK)\\n\\n    # Placeholder validation loss for non-epoch LensKit training; use 1-NDCG as a monotone surrogate.\\n    val_loss = 1.0 - ndcg10\\n    print(f\'Epoch {run_idx}: validation_loss = {val_loss:.4f}\')\\n    print(f\'Seed {seed}: Recall@{TOPK} = {rec10:.4f}, NDCG@{TOPK} = {ndcg10:.4f}\')\\n\\n    timestamp = pd.Timestamp.utcnow().isoformat()\\n    metric_record = {\\n        \'seed\': seed,\\n      