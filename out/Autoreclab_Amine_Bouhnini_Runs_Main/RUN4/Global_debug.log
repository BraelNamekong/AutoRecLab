ontrols initialization randomness\\n    try:\\n        algo = ImplicitMF(n_factors=20, learning_rate=0.05, reg=0.01, epochs=N_EPOCHS, seed=seed)\\n        model = batch_train(train_ds, algo)\\n    except Exception:\\n        # Alternative constructor shapes if the API differs slightly\\n        algo = ImplicitMF(seed=seed, factors=20, lr=0.05, reg=0.01, epochs=N_EPOCHS)\\n        model = batch_train(train_ds, algo)\\n\\n    # Evaluation: for each user present in test_df, generate top-K recommendations\\n    user_list = test_df[\'user\'].unique()\\n    recall_vals = []\\n    ndcg_vals = []\\n    ground_truth_per_user = {}\\n    predictions_per_user = {}\\n\\n    # Precompute ground-truth per user from test_df\\n    for u in user_list:\\n        gt_items = test_df[test_df[\'user\'] == u][\'item\'].unique().tolist()\\n        ground_truth_per_user[u] = gt_items\\n\\n    for u in user_list:\\n        try:\\n            recs = model.recommend(u, N=K)  # list of item ids in ranked order\\n        except TypeError:\\n            # Some versions expect positional argument name\\n            recs = model.recommend(u, K)\\n        rec_items = [it for it in recs]\\n        gt_items = ground_truth_per_user.get(u, [])\\n        if len(gt_items) == 0:\\n            continue\\n        hits = len(set(rec_items) & set(gt_items))\\n        recall_u = hits / min(K, len(gt_items))\\n        recall_vals.append(recall_u)\\n        # NDCG@K\\n        dcg = 0.0\\n        for rank, item in enumerate(rec_items, start=1):\\n            if item in gt_items:\\n                dcg += 1.0 / np.log2(rank + 1)\\n        idcg = sum(1.0 / np.log2(i + 1) for i in range(1, min(len(gt_items), K) + 1)) if gt_items else 0.0\\n        ndcg = dcg / idcg if idcg > 0 else 0.0\\n        ndcg_vals.append(ndcg)\\n\\n    if len(recall_vals) == 0:\\n        avg_recall = 0.0\\n        avg_ndcg = 0.0\\n    else:\\n        avg_recall = float(np.mean(recall_vals))\\n        avg_ndcg = float(np.mean(ndcg_vals))\\n\\n  