\'item\'] = df[\'item\'].astype(int)\ndf[\'rating\'] = df[\'rating\'].astype(float)\ndf[\'timestamp\'] = df[\'timestamp\'].astype(int)\n\n# Experiment settings\nSEEDS = [0, 1, 2, 3, 4]\nTEST_SIZE_PER_USER = 0.2\nK_values = [5, 10, 20]\n# Hyperparameters (kept fixed across seeds as requested)\nN_FACTORS = 20\nREG = 0.01\nLR = 0.05\nN_EPOCHS = 15\nALPHA = 40.0  # confidence = 1 + alpha * rating\n\nexperiment_key = \'movielens100k_seed_experiments\'\n# Initialize the experiment data structure\nexperiment_data = {\n    experiment_key: {\n        \'metrics\': {\'val\': []},  # per-seed scalar placeholder for compatibility\n        \'losses\': {\'val\': []},\n        \'predictions\': [],  # per-seed per-user top-k lists (compact)\n        \'ground_truth\': [],\n        \'per_seed\': {}\n    }\n}\n\n# Remap IDs to 0-based indices for LensKit compatibility\nall_users = df[\'user\'].unique()\nall_items = df[\'item\'].unique()\nuser_map = {u: i for i, u in enumerate(sorted(all_users))}\nitem_map = {i: idx for idx, i in enumerate(sorted(all_items))}\ndf[\'user0\'] = df[\'user\'].map(user_map)\ndf[\'item0\'] = df[\'item\'].map(item_map)\nnum_users = len(user_map)\nnum_items = len(item_map)\n\n# Build a simple per-user holdout split function (deterministic given seed)\ndef per_user_split(input_df, test_size, seed):\n    train_list = []\n    test_list = []\n    for uid, group in input_df.groupby(\'user0\'):\n        g = group.copy()\n        if len(g) < 2:\n            train_list.append(g)\n            continue\n        seed_for_user = (int(seed) * 0x9e3779b9) ^ (int(uid) & 0xffffffff)\n        rng = np.random.RandomState(seed_for_user & 0xffffffff)\n        n_test = max(1, int(len(g) * test_size))\n        test_idx = rng.choice(g.index, size=n_test, replace=False)\n        train_idx = g.index.difference(test_idx)\n        train_list.append(g.loc[train_idx])\n        test_list.append(g.loc[test_idx])\n    train_df = pd.concat(train_list) if train_list else input_df.iloc[0:0]\n   