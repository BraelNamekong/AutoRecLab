p.argsort(-scores)[:N]]\n            else:\n                rng = np.random.default_rng(seed+epoch)\n                scores = rng.random(len(candidate_items))\n                topN = [candidate_items[i] for i in np.argsort(-scores)[:N]]\n            truth_items = test_df[test_df[\'user\'] == u][\'item\'].unique()\n            if len(truth_items) == 0:\n                continue\n            truth_item = truth_items[0]\n            hit = int(truth_item in topN)\n            total_recall += hit\n            if truth_item in topN:\n                rank = int(np.where(topN == truth_item)[0][0]) + 1\n                ndcg = 1.0 / np.log2(rank + 1)\n            else:\n                ndcg = 0.0\n            total_ndcg += ndcg\n            total_users += 1\n        if total_users == 0:\n            print(f\'Seed {seed}, epoch {epoch}: no evaluable users, skipping metrics for this epoch.\')\n            val_recall = float(\'nan\')\n            val_ndcg = float(\'nan\')\n        else:\n            val_recall = total_recall / total_users\n            val_ndcg = total_ndcg / total_users\n        # Validation-like RMSE on test set (using available predictions if possible)\n        if lenskit_available and batch is not None and algo is not None:\n            try:\n                test_pairs = test_df[[\'user\',\'item\']].copy()\n                preds_test = batch.predict(algo, test_pairs)\n                if \'score\' in preds_test.columns:\n                    pred_scores = preds_test[\'score\'].values\n                else:\n                    pred_scores = preds_test[\'prediction\'].values\n                true_ratings = test_df[\'rating\'].values\n                min_len = min(len(pred_scores), len(true_ratings))\n                pred_scores = pred_scores[:min_len]\n                true_ratings = true_ratings[:min_len]\n                rmse_epoch = float(np.sqrt(np.mean((pred_scores - true_ratings) ** 2)))\n            except Exception:\n                rmse_epoch = float(\'nan\')\n        else:\n            rmse_epoch = float(\'nan\')\n        print(f"Seed {seed} Epoch {epoch}: val_loss_rmse={rmse_epoch:.4f}, recall@{N}={val_recall:.4f}, ndcg@{N}={val_ndcg:.4f}")\n        epoch_metrics.append({\'epoch\': epoch, \'val_rmse\': rmse_epoch, \'recall_at_n\': val_recall, \'ndcg_at_n\': val_ndcg})\n\n        if epoch == max_epochs:\n            final_recall = val_recall\n            final_ndcg = val_ndcg\n            final_rmse = rmse_epoch\n            break\n\n    results_all.append({\'seed\': seed, \'recall_at_n\': final_recall, \'ndcg_at_n\': final_ndcg, \'rmse\': final_rmse, \'epochs\': epoch_metrics})\n    per_seed_summaries.append({\'seed\': seed, \'recall_at_n\': final_recall, \'ndcg_at_n\': final_ndcg, \'rmse\': final_rmse})\n\n# Aggregate results and save\ntimestamp = datetime.now().strftime(\'%Y%m%d_%H%M%S\')\naggregate = {\n    \'experiment\': experiment_id,\n    \'timestamp\': timestamp,\n    \'seeds\': results_all\n}\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), aggregate)\n# Save per-seed CSVs and a summary CSV\nsummary_rows = []\nfor r in results_all:\n    summary_rows.append({\'seed\': r[\'seed\'], \'recall_at_n\': r[\'recall_at_n\'], \'ndcg_at_n\': r[\'ndcg_at_n\'], \'rmse\': r[\'rmse\']})\nsummary_df = pd.DataFrame(summary_rows)\nsummary_csv = os.path.join(working_dir, \'summary_seed_results.csv\')\nsummary_df.to_csv(summary_csv, index=False)\n# Aggregated metrics across seeds\nvalid_rows = [row for row in per_seed_summaries if row[\'recall_at_n\'] is not None and not isinstance(row[\'recall_at_n\'], float) or (pd.notnull(row[\'recall_at_n\']))]\n# Save a simple aggregated CSV with mean/std\nrecalls = [r[\'recall_at_n\'] for r in per_seed_summaries if isinstance(r[\'recall_at_n\'], (float,int)) and not np.isnan(r[\'recall_at_n\'])]\ndcg_vals = [r[\'ndcg_at_n\'] for r in per_seed_summaries if isinstance(r[\'ndcg_at_n\'], (float,int)) and not np.isnan(r[\'ndcg_at_n\'])]\nrmean = float(np.mean(recalls)) if recal