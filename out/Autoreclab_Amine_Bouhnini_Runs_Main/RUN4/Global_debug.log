ue\n        gt_set = set(int(x) for x in gt)\n        for k in top_k_list:\n            topk = ranked_items[:k]\n            dcg = 0.0\n            for rank, item in enumerate(topk, start=1):\n                if int(item) in gt_set:\n                    dcg += 1.0 / math.log(rank + 1, 2)\n            idcg = sum(1.0 / math.log(r + 1, 2) for r in range(1, min(k, len(gt_set)) + 1))\n            ndcg = dcg / max(idcg, 1e-12)\n            recall = len([it for it in topk if int(it) in gt_set]) / float(len(gt_set))\n            ndcg_acc[k] += ndcg\n            recall_acc[k] += recall\n        count += 1\n    if count == 0:\n        return {k: {"ndcg":0.0, "recall":0.0} for k in top_k_list}\n    for k in top_k_list:\n        ndcg_acc[k] /= count\n        recall_acc[k] /= count\n    return {k: {"ndcg": ndcg_acc[k], "recall": recall_acc[k]} for k in top_k_list}\n\n# Main loop: train with different seeds using LensKit\'s ImplicitMF\nresults_rows = []\nexperiment_data = {\n    \'MovieLens100K_ImplicitMF\': {\n        \'metrics\': {\'val\': []},\n        \'losses\': {\'train\': []},\n        \'predictions\': [],\n        \'ground_truth\': [],\n        \'seed\': None\n    }\n}\nstart_time = time.time()\n\nfor seed in CONFIG[\'seeds\']:\n    t0 = time.time()\n    # Initialize a LensKit ImplicitMF model per seed\n    try:\n        from lenskit.algorithms.implicit import ImplicitMF\n    except Exception as e:\n        raise SystemExit("LensKit ImplicitMF not available. Please install lenskit. Error: {}".format(e))\n    # Instantiate model (seed controls initialization/randomness)\n    algo = ImplicitMF(features=CONFIG[\'latent_factors\'], iterations=CONFIG[\'epochs\'], learning_rate=CONFIG[\'lr\'], reg=CONFIG[\'reg\'], random_state=seed)\n    # Prepare training DataFrame for LensKit: user, item, rating (implicit: 1.0 for observed interactions)\n    train_df = pd.DataFrame([(u, i, 1.0) for (u, i) in train_pairs], columns=[\'user\', \'item\', \'rating\'])\n    # Fit model\n    model =