ng (LensKit uses alpha in ImplicitMF)\nlambda_ = 0.01\nn_factors = 20\niterations_per_epoch = 1  # approximate epoch step\n\n# Prepare global per-seed results container\nexperiment_id = \'movielens100k_implicitmf_seed_variation\'\nresults_all = []\nper_seed_summaries = []\n\n# Helper: per-user train/test split (hold out 1 interaction per user if possible)\nfrom collections import defaultdict\nimport random\n\ndef per_user_holdout_split(df, seed, test_per_user=1):\n    rng = np.random.default_rng(seed)\n    train_rows = []\n    test_rows = []\n    for u, group in df.groupby(\'user\'):\n        if len(group) <= test_per_user:\n            continue\n        perm = rng.permutation(len(group))\n        test_idx = perm[:test_per_user]\n        train_mask = np.ones(len(group), dtype=bool)\n        train_mask[test_idx] = False\n        train_rows.append(group.iloc[train_mask])\n        test_rows.append(group.iloc[test_idx])\n    if not train_rows:\n        train_df = df.sample(frac=0.8, random_state=seed)\n        test_df = df.drop(train_df.index)\n        return train_df, test_df\n    train_df = pd.concat(train_rows, ignore_index=True)\n    test_df = pd.concat(test_rows, ignore_index=True)\n    return train_df, test_df\n\n# Try to import LensKit\ntry:\n    from lenskit.algorithms.implicit import ImplicitMF\n    from lenskit import batch\n    lenskit_available = True\nexcept Exception:\n    lenskit_available = False\n    ImplicitMF = None\n    batch = None\n\n# All items set for candidate generation\nall_items = sorted(ml_df[\'item\'].unique())\n\nfor seed in seeds:\n    # Split data for this seed\n    train_df, test_df = per_user_holdout_split(ml_df, seed=seed, test_per_user=1)\n    if train_df is None or test_df is None or len(train_df) == 0 or len(test_df) == 0:\n        print(f\'Seed {seed}: insufficient data after split, skipping.\')\n        continue\n\n    epoch_metrics = []\n    final_recall = None\n    final_ndcg = None\n    final_rmse = None\n\n    # Epoch loop: r