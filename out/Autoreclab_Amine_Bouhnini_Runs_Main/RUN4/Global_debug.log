[\'rating\'] = df[\'rating\'].astype(float)\n    df[\'ts\'] = df[\'ts\'].astype(int)\n    return df\n\n\ndef train_test_split_holdout(df: pd.DataFrame, test_per_user: int, seed: int) -> (pd.DataFrame, pd.DataFrame):\n    # For each user, randomly hold out up to test_per_user interactions\n    train_rows = []\n    test_rows = []\n    rng = np.random.RandomState(seed)\n    for user, grp in df.groupby(\'user\'):\n        if len(grp) <= test_per_user:\n            train_rows.append(grp)\n            continue\n        # sample test_per_user items as the held-out set\n        test_grp = grp.sample(n=min(test_per_user, len(grp) - 1), random_state=seed)\n        train_grp = grp.drop(index=test_grp.index)\n        train_rows.append(train_grp)\n        test_rows.append(test_grp)\n    train_df = pd.concat(train_rows) if train_rows else df.iloc[0:0]\n    test_df = pd.concat(test_rows) if test_rows else df.iloc[0:0]\n    return train_df, test_df\n\n\ndef compute_rank_metrics(preds: dict, test_df: pd.DataFrame, k: int) -> (float, float):\n    # preds: user -> list of (item, score)\n    ndcg_sum = 0.0\n    recall_sum = 0.0\n    cnt = 0\n    for _, row in test_df.iterrows():\n        u = int(row[\'user\'])\n        held_item = int(row[\'item\'])\n        items_scores = preds.get(u, [])\n        ranked = [it for it, sc in sorted(items_scores, key=lambda x: -x[1])][:k]\n        try:\n            rank_pos = ranked.index(held_item) + 1\n        except ValueError:\n            rank_pos = None\n        rel = 1 if held_item in ranked else 0\n        ndcg = 0.0\n        if rank_pos is not None:\n            ndcg = 1.0 / np.log2(rank_pos + 1)\n        recall = rel\n        ndcg_sum += ndcg\n        recall_sum += recall\n        cnt += 1\n    if cnt == 0:\n        return 0.0, 0.0\n    return ndcg_sum / cnt, recall_sum / cnt\n\n# Try to import LensKit (best effort)\ntry:\n    from lenskit.algorithms.implicit import ImplicitMF\n    from lenskit import datasets as lkds\n    HAVE_LK = True\nexce