_u = u_vec.copy()\n            U[u] -= lr * (grad * v_vec + reg * u_vec)\n            V[i] -= lr * (grad * old_u + reg * v_vec)\n            train_loss += -np.log(p + 1e-12)\n        train_loss /= max(1, len(train_pairs))\n        epoch_losses.append(train_loss)\n        if test_pairs:\n            val_loss = 0.0\n            for (u, i) in test_pairs:\n                score = U[u] @ V[i]\n                p = 1.0 / (1.0 + np.exp(-score))\n                val_loss += -np.log(p + 1e-12)\n            val_loss /= max(1, len(test_pairs))\n            val_ks[epoch] = val_loss\n    return U, V, epoch_losses, val_ks\n\n# Evaluate rankings for a given user set and matrices\ndef evaluate_ranking(U, V, test_users, gt_per_user, top_k_list: List[int]):\n    ndcg_vals = [0.0] * len(top_k_list)\n    recall_vals = [0.0] * len(top_k_list)\n    count = 0\n    for u in sorted(test_users):\n        scores = U[u] @ V.T\n        ranked_items = np.argsort(scores)[::-1]\n        gt = gt_per_user.get(int(u), set())\n        if len(gt) == 0:\n            continue\n        for idx, k in enumerate(top_k_list):\n            ndcg_vals[idx] += ndcg_at_k(ranked_items, gt, k)\n            recall_vals[idx] += recall_at_k(ranked_items, gt, k)\n        count += 1\n    if count > 0:\n        ndcg_vals = [v / count for v in ndcg_vals]\n        recall_vals = [v / count for v in recall_vals]\n    return ndcg_vals, recall_vals\n\n# Prepare storage for per-run results\nresults_rows = []\nexperiment_data = {\n    config[\'dataset_name\']: {\n        \'metrics\': {\'val\': []},\n        \'losses\': {\'train\': []},\n        \'predictions\': [],\n        \'ground_truth\': [],\n        \'seed\': None,\n    }\n}\nstart_time = time.time()\n\n# Iterate over seeds and run experiments\nfor seed in config[\'seeds\']:\n    t0 = time.time()\n    # Deterministic training data per run (weights initialization is seeded)\n    U, V, train_losses, val_per_epoch = train_fallback_sgd(\n        train_pairs, n_users, n_items, seed,\n        epochs=config[\'epochs\'], lr=config[\'lr\'], reg=config[\'reg\'], k=config[\'num_factors\'],\n        test_pairs=test_pairs, gt_per_user=gt_per_user\n    )\n    test_users = sorted(gt_per_user.keys())\n    ndcg_vals, recall_vals = evaluate_ranking(U, V, test_users, gt_per_user, config[\'top_k\'])\n    # Print per-epoch training loss and final metrics\n    for epoch, v in enumerate(train_losses, start=1):\n        print(f"Seed {seed} Epoch {epoch}/{config[\'epochs\']}: training_loss={v:.6f}, val_loss={val_per_epoch[epoch-1] if val_per_epoch[epoch-1] is not None else \'na\'}")\n    row = {\'run_id\': f\'run_{seed}\', \'seed\': seed}\n    for idx, k in enumerate(config[\'top_k\']):\n        row[f\'ndcg@{k}\'] = ndcg_vals[idx]\n        row[f\'recall@{k}\'] = recall_vals[idx]\n    results_rows.append(row)\n    experiment_data[config[\'dataset_name\']][\'metrics\'][\'val\'].append((seed, val_per_epoch[-1] if val_per_epoch[-1] is not None else None))\n    experiment_data[config[\'dataset_name\']][\'losses\'][\'train\'].append((seed, train_losses))\n    experiment_data[config[\'dataset_name\']][\'seed\'] = seed\n    t1 = time.time()\n    print(f"Seed {seed} completed in {t1-t0:.2f} sec. Final ndcg@5/10/20: {ndcg_vals[0]:.4f}, {ndcg_vals[1]:.4f}, {ndcg_vals[2]:.4f}")\n\n# Save results to CSV and numpy file\nresults_df = pd.DataFrame(results_rows)\nresults_csv_path = os.path.join(working_dir, \'results.csv\')\nresults_df.to_csv(results_csv_path, index=False)\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nprint(\'Saved per-run results to\', results_csv_path)\nprint(\'Experiment data saved to\', os.path.join(working_dir, \'experiment_data.npy\'))\nprint(\'Total elapsed time: {:.2f} sec\'.format(time.time() - start_time))\n\n```', 'Execution output': '```\nSeed 0 Epoch 1/5: training_loss=0.692400, val_loss=0.6882406782644707\nSeed 0 Epoch 2/5: training_loss=0.627413, val_loss=0.49532458134321067\nSeed 0 Epoch 3/5: training_loss=0.3243