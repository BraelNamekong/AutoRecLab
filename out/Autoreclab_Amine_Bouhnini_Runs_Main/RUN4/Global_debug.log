pairs, gt_per_user\\ntrain_pairs, test_pairs, gt_per_user = fixed_split_all_users(df, config[\'test_frac\'], config[\'split_seed\'])\\n\\n# Metric helpers (manual implementations to avoid heavy dependencies)\\nimport operator\\nimport itertools\\n\\ndef ndcg_at_k(pred_ranks: List[int], gt_set: set, k: int) -> float:\\n    # pred_ranks: list of item ids in ranked order\\n    dcg = 0.0\\n    for rank, item in enumerate(pred_ranks[:k], start=1):\\n        if int(item) in gt_set:\\n            dcg += 1.0 / math.log2(rank + 1)\\n    # ideal DCG: 1 per relevant item up to min(k, |gt|)\\n    idcg = sum(1.0 / math.log2(r + 1) for r in range(1, min(k, len(gt_set)) + 1))\\n    if idcg <= 0:\\n        return 0.0\\n    return dcg / idcg\\n\\ndef recall_at_k(pred_ranks: List[int], gt_set: set, k: int) -> float:\\n    topk = set(int(x) for x in pred_ranks[:k])\\n    if len(gt_set) == 0:\\n        return 0.0\\n    return len(topk & gt_set) / float(len(gt_set))\\n\\n# Simple fallback training using implicit matrix factorization with SGD (deterministic across seeds)\\ndef train_fallback_sgd(train_pairs, n_users, n_items, seed, epochs=config[\'epochs\'], lr=config[\'lr\'], reg=config[\'reg\'], k=config[\'num_factors\'], test_pairs=None, gt_per_user=None):\\n    rng = np.random.default_rng(seed)\\n    U = rng.normal(scale=0.1, size=(n_users, k))\\n    V = rng.normal(scale=0.1, size=(n_items, k))\\n    epoch_losses = []\\n    val_ks = [None] * epochs\\n    for epoch in range(epochs):\\n        order = np.arange(len(train_pairs))\\n        rng.shuffle(order)\\n        train_loss = 0.0\\n        for idx in order:\\n            u, i = train_pairs[idx]\\n            u_vec = U[u]\\n            v_vec = V[i]\\n            score = u_vec @ v_vec\\n            p = 1.0 / (1.0 + np.exp(-score))\\n            grad = p - 1.0\\n            old_u = u_vec.copy()\\n            U[u] -= lr * (grad * v_vec + reg * u_vec)\\n            V[i] -= lr * (grad * old_u + reg * v_vec)\\n            train_loss += -n