redictions\': [],\n        \'ground_truth\': [],\n        \'seeds\': [],\n        \'timestamps\': []\n    }\n}\n\n# Load MovieLens100K u.data: user, item, rating, timestamp\nratings = pd.read_csv(\n    DATA_PATH,\n    sep=\'\\t\',\n    names=[\'user\', \'item\', \'rating\', \'timestamp\'],\n    engine=\'python\'\n)\n\n# Normalize to implicit feedback for ImplicitMF: one positive event per observed interaction.\nratings = ratings[[\'user\', \'item\', \'rating\', \'timestamp\']].copy()\nratings[\'rating\'] = 1.0\n\ntrain_df, test_df = train_test_split(\n    ratings,\n    test_size=TEST_FRAC,\n    random_state=GLOBAL_SPLIT_SEED,\n    shuffle=True\n)\n\n# Keep only users appearing in train for recommendation; evaluate on their held-out positives.\ntrain_users = set(train_df[\'user\'].unique())\ntrain_items = set(train_df[\'item\'].unique())\ntest_df = test_df[test_df[\'user\'].isin(train_users) & test_df[\'item\'].isin(train_items)].copy()\n\ntruth = test_df.groupby(\'user\')[\'item\'].apply(set)\ntruth = truth[truth.apply(len) >= MIN_TEST_ITEMS]\nusers = truth.index.to_numpy()\n\n# LensKit test set for top-N evaluation.\ntest_pairs = pd.DataFrame({\n    \'user\': np.repeat(list(truth.index), [len(s) for s in truth.values]),\n    \'item\': np.concatenate([np.array(list(s)) for s in truth.values])\n}) if len(truth) else pd.DataFrame(columns=[\'user\', \'item\'])\n\ndef recall_at_k(recs, truth_sets, k=10):\n    vals = []\n    for u, grp in recs.groupby(\'user\'):\n        pred = grp.sort_values(\'rank\')[\'item\'].head(k).tolist()\n        gt = truth_sets.get(u, set())\n        if gt:\n            vals.append(len(set(pred) & gt) / len(gt))\n    return float(np.mean(vals)) if vals else 0.0\n\ndef ndcg_at_k(recs, truth_sets, k=10):\n    vals = []\n    for u, grp in recs.groupby(\'user\'):\n        ranked = grp.sort_values(\'rank\')[\'item\'].head(k).tolist()\n        gt = truth_sets.get(u, set())\n        if not gt:\n            continue\n        dcg = 0.0\n        for i, it in enumerate(ranked, start=1):\n            if it in gt:\n                dcg += 1.0 / np.log2(i + 1)\n        ideal_hits = min(len(gt), k)\n        idcg = sum(1.0 / np.log2(i + 1) for i in range(1, ideal_hits + 1))\n        vals.append(dcg / idcg if idcg > 0 else 0.0)\n    return float(np.mean(vals)) if vals else 0.0\n\nall_metrics = []\nall_rec_counts = []\ntruth_dict = truth.to_dict()\n\nfor run_idx, seed in enumerate(MODEL_SEEDS, start=1):\n    algo = ImplicitMF(features=20, iterations=15, reg=0.1, weight=40, method=\'cg\', rng_spec=seed)\n    algo = Recommender.adapt(algo)\n    algo.fit(train_df[[\'user\', \'item\', \'rating\']])\n\n    recs = batch.recommend(algo, users, TOPK)\n    recs = recs.sort_values([\'user\', \'rank\']).reset_index(drop=True)\n\n    rec10 = recall_at_k(recs, truth_dict, k=TOPK)\n    ndcg10 = ndcg_at_k(recs, truth_dict, k=TOPK)\n\n    # Placeholder validation loss for non-epoch LensKit training; use 1-NDCG as a monotone surrogate.\n    val_loss = 1.0 - ndcg10\n    print(f\'Epoch {run_idx}: validation_loss = {val_loss:.4f}\')\n    print(f\'Seed {seed}: Recall@{TOPK} = {rec10:.4f}, NDCG@{TOPK} = {ndcg10:.4f}\')\n\n    timestamp = pd.Timestamp.utcnow().isoformat()\n    metric_record = {\n        \'seed\': seed,\n        \'Recall@10\': rec10,\n        \'NDCG@10\': ndcg10,\n        \'timestamp\': timestamp\n    }\n    all_metrics.append(metric_record)\n    all_rec_counts.append(len(recs))\n\n    experiment_data[\'ml100k_u_data\'][\'metrics\'][\'val\'].append(metric_record)\n    experiment_data[\'ml100k_u_data\'][\'losses\'][\'val\'].append({\'epoch\': run_idx, \'validation_loss\': val_loss, \'timestamp\': timestamp})\n    experiment_data[\'ml100k_u_data\'][\'predictions\'].append(recs[[\'user\', \'item\', \'rank\', \'score\']].to_dict(\'records\'))\n    experiment_data[\'ml100k_u_data\'][\'ground_truth\'].append(test_pairs.to_dict(\'records\'))\n    experiment_data[\'ml100k_u_data\'][\'seeds\'].append(seed)\n    experiment_data[\'ml100k_u_data\'][\'timestamps\'].append(timestamp)\n\nmetrics_df = pd.DataFrame(all_metrics)\nrec_mean, rec_std = metrics_df[\'Recall@10\'].mean(), metrics_df[\'Recall@10\'].std(ddof=1)\nndcg_mean, ndcg_std = metrics_df[\'NDCG@10\'].mean(), metrics_df[\'NDCG@10\'].std(ddof=1)\n\nprint(\'\\nSummary across seeds\')\nprint(metrics_df[[\'seed\', \'Recall@10\', \'NDCG@10\']].to_string(index=False))\nprint(f"Recall@{TOPK}: mean={rec_mean:.4f}, std={rec_std:.4f}, min={metrics_df[\'Recall@10\'].min():.4f}, max={metrics_df[\'Recall@10\'].max():.4f}, rel_std={100*rec_std/(rec_mean+1e-12):.2f}%")\nprint(f"NDCG@{TOPK}: mean={ndcg_mean:.4f}, std={ndcg_std:.4f}, min={metrics_df[\'NDCG@10\'].min():.4f}, max={metrics_df[\'NDCG@10\'].max():.4f}, rel_std={100*ndcg_std/(ndcg_mean+1e-12):.2f}%")\n\n# Save plottable data\nnp.save(os.path.join(working_dir, \'ml100k_metrics_array.npy\'), metrics_df[[\'seed\', \'Recall@10\', \'NDCG@10\']].to_numpy())\nnp.save(os.path.join(working_dir, \'ml100k_rec_counts.npy\'), np.array(all_rec_counts))\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\n\n# Visualizations\nplt.figure(figsize=(8, 4))\nplt.plot(metrics_df[\'seed\'], metrics_df[\'Recall@10\'], marker=\'o\', label=f\'Recall@{TOPK}\')\nplt.plot(metrics_df[\'seed\'], metrics_df[\'NDCG@10\'], marker=\'s\', label=f\'NDCG@{TOPK}\')\nplt.xlabel(\'Model seed\')\nplt.ylabel(\'Metric\')\nplt.title(\'Metric variation across random seeds (MovieLens100K)\')\nplt.legend()\nplt.grid(True, alpha=0.3)\nplt.tight_layout()\nplt.savefig(os.path.join(working_dir, \'ml100k_seed_variation.png\'), dpi=150)\nplt.close()\n\nplt.figure(figsize=(8, 4))\nplt.boxplot([metrics_df[\'Recall@10\'], metrics_df[\'NDCG@10\']], labels=[f\'Recall@{TOPK}\', f\'NDCG@{TOPK}\'])\nplt.ylabel(\'Metric\')\nplt.title(\'Distribution of metrics across seeds (MovieLens100K)\')\nplt.tight_layout()\nplt.savefig(os.path.join(working_dir, \'ml100k_metric_boxplot.png\'), dpi=150)\nplt.close()\n\n```', 'Execution Output': '```\n