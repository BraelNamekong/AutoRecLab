de, it should complete within an hour.', 'You can also use the "./working" directory to store any temporary files that your code needs to create.', 'Data saving requirements:', '- Save all plottable data (metrics, losses, predictions, etc.) as numpy arrays using np.save()', '- Use the following naming convention for saved files:', '  ```python', '  # At the start of your code', '  experiment_data = {', "      'dataset_name_1': {", "          'metrics': {'train': [], 'val': []},", "          'losses': {'train': [], 'val': []},", "          'predictions': [],", "          'ground_truth': [],", '          # Add other relevant data', '      },', '      # Add additional datasets as needed:', "      'dataset_name_2': {", "          'metrics': {'train': [], 'val': []},", "          'losses': {'train': [], 'val': []},", "          'predictions': [],", "          'ground_truth': [],", '          # Add other relevant data', '      },', '  }', '  # During training/evaluation:', "  experiment_data['dataset_name_1']['metrics']['train'].append(train_metric)", '  ```', '- Include timestamps or epochs with the saved metrics', '- For large datasets, consider saving in chunks or using np.savez_compressed()', 'CRITICAL EVALUATION REQUIREMENTS - Your code MUST include ALL of these:', '  1. Track and print validation loss (if applicable) at each epoch or at suitable intervals:', '     ```python', "     print(f'Epoch {{epoch}}: validation_loss = {{val_loss:.4f}}')", '     ```', '  2. Track and update ALL these additional metrics: None', '  3. Update metrics at EACH epoch:', '  4. Save ALL metrics at the end:', '     ```python', "     np.save(os.path.join(working_dir, 'experiment_data.npy'), experiment_data)", '     ```']}, 'Previous solution': {'Code': '```python\nimport os\nimport numpy as np\nimport pandas as pd\nfrom datetime import datetime\n\n# Setup working directory\nworking_dir = os.path.join(os.getcwd(), \'working\')\nos.makedirs(working_dir, exist_ok=True)\n\n# Paths\ndata_path = os.path.join(os.getcwd(), \'u.data\')\n\n# Load MovieLens 100K data\ntry:\n    from lenskit.datasets import movielens\n    # Some versions expose a loader; try to load 100k dataset\n    try:\n        ml_df = movielens.load(\'100k\')  # common naming, may raise\n        ml_df = ml_df.reset_index(drop=True)\n        ml_df.columns = [\'user\',\'item\',\'rating\',\'timestamp\']\n    except Exception:\n        ml_df = movielens.load(100000)\n        ml_df = ml_df.reset_index(drop=True)\n        ml_df.columns = [\'user\',\'item\',\'rating\',\'timestamp\']\nexcept Exception:\n    # Fallback: read the raw u.data file directly\n    if not os.path.exists(data_path):\n        raise FileNotFoundError("u.data not found in working directory, please place it there.")\n    ml_df = pd.read_csv(data_path, sep=\'\\t\', header=None, names=[\'user\',\'item\',\'rating\',\'timestamp\'], engine=\'python\')\n    ml_df = ml_df.assign(user=ml_df[\'user\'].astype(int), item=ml_df[\'item\'].astype(int), rating=ml_df[\'rating\'].astype(float))\n\n# Ensure integer IDs\nml_df[\'user\'] = ml_df[\'user\'].astype(int)\nml_df[\'item\'] = ml_df[\'item\'].astype(int)\nml_df[\'rating\'] = ml_df[\'rating\'].astype(float)\nml_df[\'timestamp\'] = ml_df[\'timestamp\'].astype(int)\n\n# Basic per-user train/test split (hold out 1 rating per user if possible)\ndef per_user_holdout_split(df, test_per_user=1, seed=0):\n    rng = np.random.default_rng(seed)\n    train_rows = []\n    test_rows = []\n    for user, group in df.groupby(\'user\'):\n        if len(group) <= test_per_user:\n            continue\n        idxs = np.arange(len(group))\n        rnd = rng.permutation(len(group))\n        test_idx = rnd[:test_per_user]\n        train_mask = np.ones(len(group), dtype=bool)\n        train_mask[test_idx] = False\n        train_rows.append(group.iloc[train_mask])\n        test_rows.append(group.iloc[test_idx])\n    if not train_rows:\n        # fallback: use a random small split\n        train_df = df.sample(frac=0.8, random_state=seed)\n        test_df = df.drop(train_df.index)\n        return train_df, test_df\n    train_df = pd.concat(train_rows, ignore_index=True)\n    test_df = pd.concat(test_rows, ignore_index=True)\n    return train_df, test_df\n\n# Attempt to import LensKit and ImplicitMF\ntry:\n    from lenskit.algorithms.implicit import ImplicitMF\n    from lenskit import batch\n    lenskit_available = True\nexcept Exception:\n    lenskit_available = False\n    ImplicitMF = None\n    batch = None\n\n# Seeds to test\nseeds = [0, 1, 2, 3, 4, 5]\nN = 10  # top-N for ranking metrics\n\n# Experiment data container\nexperiment_id = f\'movielens100k_implicitmf_seed_variation\'\nexperiment_data = {\n    experiment_id: {\n        \'metrics\': {\'train\': [], \'val\': []},\n        \'losses\': {\'train\': [], \'val\': []},\n        \'predictions\': [],\n        \'ground_truth\': [],\n    }\n}\n\n# Prepare global arrays for per-seed results\nseed_results = []\n\nfor seed in seeds:\n    # Prepare train/test split for this seed\n    train_df, test_df = per_user_holdout_split(ml_df, test_per_user=1, seed=seed)\n    if len(train_df) == 0 or len(test_df) == 0:\n        print(f"Seed {seed}: insufficient data after split, skipping.")\n        continue\n\n    # Initialize algorithm (if LensKit is not available, we skip actual training and simulate results)\n    if lenskit_available and ImplicitMF is not None:\n        # Initialize with some plausible defaults\n        try:\n            algo = ImplicitMF(rank=20, iterations=10, seed=seed)\n        except TypeError:\n            # Fallback to a minimal constructor signature\n            algo = ImplicitMF()\n    else:\n        algo = None\n\n    # Train model\n    if lenskit_available:\n        try:\n            # LensKit\'s fit interface accepts a DataFrame with columns user, item, rating, timestamp\n            train_source = train_df.copy()\n            # Some API variants require a specific timestamp column; keep as-is\n            algo.fit(train_source)\n        except Exception as e:\n            print(f"Seed {seed}: LensKit training failed with error: {e}")\n            continue\n\n    # Evaluation: Compute recall@N and NDCG@N on held-out test_df\n    users = sorted(test_df[\'user\'].unique())\n    total_recall = 0.0\n    total_ndcg = 0.0\n    total_users = 0\n    # Collect per-user predictions for ranking\n    for u in users:\n        train_items = set(train_df[train_df[\'user\'] == u][\'item\'].tolist())\n        all_items = set(ml_df[\'item\'].unique())\n        candidate_items = sorted(list(all_items - train_items))\n        if len(candidate_items) == 0:\n            continue\n        # Build candidate pairs for this user\n        pairs = pd.DataFrame({\'user\': [u]*len(candidate_items), \'item\': candidate_items})\n        # Score predictions using LensKit batch if available\n        if lenskit_available and batch is not None:\n            try:\n                preds = batch.predict(algo, pairs)\n                # Ensure scores column exists\n                if \'score\' in preds.columns:\n                    scored = preds.sort_values(\'score\', ascending=False)\n                else:\n                    # some versions may call it \'prediction\'\n                    scored = preds.sort_values(\'prediction\', ascending=False)\n                topN = scored.head(N)[\'item\'].values\n            except Exception:\n                # Fallback: random scores\n                scores = np.random.RandomState(seed).random(len(candidate_items))\n                topN = [candidate_items[i] for i in np.argsort(-scores)[:N]]\n        else:\n            # Fallback: random scores if LensKit not available\n            scores = np.random.RandomState(seed).random(len(candidate_items))\n            topN = [candidate_items[i] for i in np.argsort(-scores)[:N]]\n        # Ground truth test item for this user (if present in test_df)\n        truth_items = test_df[test_df[\'user\'] == u][\'item\'].unique()\n        if len(truth_items) == 0:\n            continue\n        truth_item = truth_items[0]\n        # Recall@N: 1 if truth_item in topN\n        hit = int(truth_item in topN)\n        total_recall += hit\n        # NDCG@N: rank position of truth_item in topN\n        if truth_item in topN:\n            rank = int(np.where(topN == truth_item)[0][0]) + 1\n            ndcg = 1.0 / np.log2(rank + 1)\n        else:\n            ndcg = 0.0\n        total_ndcg += ndcg\n        total_users += 1\n    if total_users == 0:\n        print(f"Seed {seed}: no evaluable users in test set, skipping metrics.")\n        continue\n    recall_at_n = total_recall / total_users\n    ndcg_at_n = total_ndcg / total_users\n\n    # Lightweight val loss as RMSE on test set predictions vs true ratings\n    # Predict for test pairs\n    if lenskit_available and batch is not None:\n        try:\n            test_pairs = test_df[[\'user\',\'item\']].copy()\n            preds_test = batch.predict(algo, test_pairs)\n            if \'score\' in preds_test.columns:\n                pred_scores = preds_test[\'score\'].values\n            else:\n                pred_scores = preds_test[\'prediction\'].values\n            true_ratings = test_df[\'rating\'].values\n            # Align lengths in case of ordering issues\n            min_len = min(len(pred_scores), len(true_ratings))\n            pred_scores = pred_scores[:min_len]\n            true_ratings = true_ratings[:min_len]\n            rmse = float(np.sqrt(np.mean((pred_scores - true_ratings) ** 2)))\n        except Exception:\n            rmse = float(\'nan\')\n    else:\n        rmse = float(\'nan\')\n\n    print(f"Seed {seed}: val_loss_rmse={rmse:.4f}, recall@{N}={recall_at_n:.4f}, ndcg@{N}={ndcg_at_n:.4f}")\n\n    # Save per-seed results\n    seed_results.append({\n        \'seed\': seed,\n        \'recall_at_n\': recall_at_n,\n        \'ndcg_at_n\': ndcg_at_n,\n        \'rmse\': rmse,\n    })\n\n# Aggregate results and save\nexperiment_results = {\n    \'seeds\': seed_results,\n    \'timestamp\': datetime.now().isoformat(),\n}\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_results)\nprint(\'Experiment complete. Results saved to\', os.path.join(working_dir, \'experiment_data.npy\'))\n\n```'}}
