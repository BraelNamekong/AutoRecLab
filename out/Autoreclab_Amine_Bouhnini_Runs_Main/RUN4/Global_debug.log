': {'train': [], 'val': []},\n        'predictions': [],\n        'ground_truth': [],\n        'seeds': [],\n        'recall_at_10': [],\n        'ndcg_at_10': [],\n    }\n}\n\n# ---------- load data ----------\ncols = ['user', 'item', 'rating', 'timestamp']\ndf = pd.read_csv(ratings_path, sep='\\t', names=cols, engine='python')\ndf['user'] = df['user'].astype(int)\ndf['item'] = df['item'].astype(int)\ndf['rating'] = df['rating'].astype(float)\n\n# Use a user-stratified split while keeping the experiment simple and reproducible.\ntrain_df, test_df = train_test_split(\n    df,\n    test_size=1 - train_frac,\n    random_state=42,\n    stratify=df['user']\n)\n\n# user-item ground truth for ranking eval: relevant if rating >= threshold\ntruth = test_df[test_df['rating'] >= rating_threshold].copy()\ntruth_by_user = truth.groupby('user')['item'].apply(list).to_dict()\nusers = sorted(set(truth_by_user.keys()) & set(train_df['user'].unique()))\n\n# ---------- evaluation helpers ----------\ndef recall_at_k(recs, truth_items, k):\n    if not truth_items:\n        return np.nan\n    rec_items = list(recs[:k])\n    return len(set(rec_items) & set(truth_items)) / float(len(set(truth_items)))\n\n\ndef ndcg_at_k(recs, truth_items, k):\n    if not truth_items:\n        return np.nan\n    truth_set = set(truth_items)\n    dcg = 0.0\n    for i, item in enumerate(recs[:k]):\n        if item in truth_set:\n            dcg += 1.0 / np.log2(i + 2)\n    ideal_hits = min(len(truth_set), k)\n    idcg = sum(1.0 / np.log2(i + 2) for i in range(ideal_hits))\n    return dcg / idcg if idcg > 0 else np.nan\n\n# ---------- run repeated training ----------\nrecall_scores = []\nndcg_scores = []\ntrain_ratings = train_df[['user', 'item', 'rating']].copy()\ntrain_ds = Dataset.from_df(train_ratings, user='user', item='item', rating='rating')\n\nfor seed in seeds:\n    # keep settings fixed except the seed\n    model = ImplicitMF(features=20, iterations=15, reg=0.1, weight=1.0, progress=False, random_seed=seed)\n\n    # fit model\n    model.fit(train_ds.ratings())\n\n    # score test users with top-N recommendations\n    recs = model.recommend(users, n_recs, ratings=train_ds.ratings())\n    recs_by_user = recs.groupby('user')['item'].apply(list).to_dict() if len(recs) else {}\n\n    user_recalls = []\n    user_ndcgs = []\n    for u in users:\n        truth_items = truth_by_user.get(u, [])\n        user_recs = recs_by_user.get(u, [])\n        user_recalls.append(recall_at_k(user_recs, truth_items, n_recs))\n        user_ndcgs.append(ndcg_at_k(user_recs, truth_items, n_recs))\n\n    mean_recall = float(np.nanmean(user_recalls)) if len(user_recalls) else np.nan\n    mean_ndcg = float(np.nanmean(user_ndcgs)) if len(user_ndcgs) else np.nan\n\n    recall_scores.append(mean_recall)\n    ndcg_scores.append(mean_ndcg)\n    experiment_data['movielens100k']['seeds'].append(seed)\n    experiment_data['movielens100k']['metrics']['val'].append({'seed': seed, 'recall_at_10': mean_recall, 'ndcg_at_10': mean_ndcg})\n    experiment_data['movielens100k']['predictions'].append(np.array([len(recs_by_user.get(u, [])) for u in users], dtype=np.int32))\n    experiment_data['movielens100k']['ground_truth'].append(np.array([len(truth_by_user.get(u, [])) for u in users], dtype=np.int32))\n\n    # ImplicitMF does not expose epoch-wise validation loss in this simple setup;\n    # keep compatibility with the requested logging and saved structure.\n    experiment_data['movielens100k']['losses']['train'].append(np.nan)\n    experiment_data['movielens100k']['losses']['val'].append(np.nan)\n    experiment_data['movielens100k']['metrics']['train'].append({'seed': seed, 'placeholder': np.nan})\n\n    print(f'Seed {seed}: Recall@{n_recs} = {mean_recall:.4f}, NDCG@{n_recs} = {mean_ndcg:.4f}')\n    print(f'Epoch 1: validation_loss = {np.nan:.4f}')\n\nrecall_scores = np.array(recall_scores, dtype=float)\nndcg_scores = np.array(ndcg_scores, dtype=float)\n\n# ---------- summarize ----------\nprint('\\nSummary across seeds')\nprint(f'Recall@{n_recs}: mean={np.nanmean(recall_scores):.4f}, std={np.nanstd(recall_scores):.4f}, min={np.nanmin(recall_scores):.4f}, max={np.nanmax(recall_scores):.4f}')\nprint(f'NDCG@{n_recs}: mean={np.nanmean(ndcg_scores):.4f}, std={np.nanstd(ndcg_scores):.4f}, min={np.nanmin(ndcg_scores):.4f}, max={np.nanmax(ndcg_scores):.4f}')\n\n# ---------- save arrays ----------\nnp.save(os.path.join(working_dir, 'experiment_data.npy'), experiment_data, allow_pickle=True)\nnp.save(os.path.join(working_dir, 'movielens100k_recall_at_10.npy'), recall_scores)\nnp.save(os.path.join(working_dir, 'movielens100k_ndcg_at_10.npy'), ndcg_scores)\n\n# ---------- plot (optional) ----------\nplot_path = os.path.join(working_dir, 'movielens100k_seed_sensitivity.png')\nif HAVE_MPL:\n    plt.figure(figsize=(8, 4))\n    plt.plot(seeds, recall_scores, marker='o', label=f'Recall@{n_recs}')\n    plt.plot(seeds, ndcg_scores, marker='s', label=f'NDCG@{n_recs}')\n    plt.xlabel('Random seed')\n    plt.ylabel('Metric value')\n    plt.title('Seed sensitivity on MovieLens100K with ImplicitMF')\n    plt.legend()\n    plt.tight_layout()\n    plt.savefig(plot_path, dpi=150)\n    plt.close()\n    print(f'Plot saved to: {plot_path}')\nelse:\n    print('matplotlib is not installed; skipping plot generation.')\n    print(f'If needed, install matplotlib to save a plot at: {plot_path}')\n\n```", 'Execution Output': '```\nTraceback (most recent call last):\n  File "C:\\Users\\Amine\\desktop\\MLP_AmineB99\\Autoreclab\\treesearch\\interpreter.py", line 147, in _run_session\n    exec(compile(code, self.agent_file_name, "exec"), global_scope)\n  File "runfile.py", line 16, in <module>\n    from lenskit.data import Dataset\nImportError: cannot import name \'Dataset\' from \'lenskit.data\' (C:\\Users\\Amine\\AppData\\Roaming\\Python\\Python311\\site-packages\\lenskit\\data\\__init__.py)\nExecution time: 8 seconds seconds (time limit is an hour).\n```', 'Instructions': ['Carefully analyze the exe