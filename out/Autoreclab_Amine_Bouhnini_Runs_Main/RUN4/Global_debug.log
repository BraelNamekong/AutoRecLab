gs['user'].astype(int)\nratings['item'] = ratings['item'].astype(int)\nratings['rating'] = ratings['rating'].astype(float)\nratings['timestamp'] = ratings['timestamp'].astype(int)\n\ninteractions = ratings.loc[ratings['rating'] >= 4, ['user', 'item', 'rating', 'timestamp']].copy()\ninteractions['rating'] = 1.0\n\nuser_counts = interactions['user'].value_counts()\neligible_users = user_counts[user_counts >= 2].index\ninteractions = interactions[interactions['user'].isin(eligible_users)].copy()\n\ntrain, test = train_test_split(\n    interactions,\n    test_size=0.2,\n    random_state=2025,\n    stratify=interactions['user']\n)\n\ntrain_users = set(train['user'].unique())\ntrain_items = set(train['item'].unique())\ntest = test[test['user'].isin(train_users) & test['item'].isin(train_items)].copy()\ntruth = test.groupby('user')['item'].apply(list)\nusers = truth.index.to_numpy()\ntest_truth = test[['user', 'item']].copy()\n\nseeds = [1, 2, 3, 4, 5, 11, 17, 23, 29, 31]\nK = 10\nrla = topn.RecListAnalysis()\nrla.add_metric(topn.ndcg, k=K)\nrla.add_metric(topn.recall, k=K)\n\nall_metrics = []\nper_user_ndcg = []\nper_user_recall = []\n\nfor epoch, seed in enumerate(seeds, start=1):\n    util.init_rng(seed)\n    algo = ImplicitMF(features=40, iterations=15, weight=40, method='cg', rng_spec=seed)\n    rec_algo = Recommender.adapt(algo)\n    rec_algo.fit(train)\n\n    recs = batch.recommend(rec_algo, users, K)\n    recs = recs[recs['user'].isin(users)].copy()\n\n    results = rla.compute(recs, test_truth)\n    mean_ndcg = float(results['ndcg'].mean())\n    mean_recall = float(results['recall'].mean())\n    val_loss = 1.0 - mean_ndcg\n\n    print(f'Epoch {epoch}: validation_loss = {val_loss:.4f}; ndcg@{K} = {mean_ndcg:.4f}; recall@{K} = {mean_recall:.4f}')\n\n    all_metrics.append({'seed': seed, 'ndcg': mean_ndcg, 'recall': mean_recall})\n    per_user_ndcg.append(results.sort_index()['ndcg'].to_numpy())\n    per_user_recall.append(results.sort_index()['recall'].to_numpy())\n