[\'timestamp\'].astype(int)\n\n# Normalize IDs to be 0-based for internal math (but keep for output if needed)\ndf[\'user_id\'] = df[\'user\'] - 1\ndf[\'item_id\'] = df[\'item\'] - 1\nn_users = int(df[\'user_id\'].max()) + 1\nn_items = int(df[\'item_id\'].max()) + 1\n\n# Convert to implicit interactions (we\'ll treat rating>=4 as positive interaction)\ndf[\'interaction\'] = (df[\'rating\'] >= 4).astype(int)\n# We will use the implicit-style data for training: for simplicity, we keep the rating as 1 for all interactions\n\ndef train_test_split_per_user(df, seed=0):\n    rng = np.random.default_rng(seed)\n    train_rows = []\n    test_rows = []\n    grouped = df.groupby(\'user_id\')\n    for uid, group in grouped:\n        if len(group) == 0:\n            continue\n        # choose 1 random interaction as test if available\n        idxs = np.arange(len(group))\n        test_idx = rng.choice(idxs, size=1, replace=False)\n        # rest go to train\n        for i, row in enumerate(group.itertuples(index=False)):\n            if i in test_idx:\n                test_rows.append(row._asdict())\n            else:\n                train_rows.append(row._asdict())\n    train_df = pd.DataFrame(train_rows)\n    test_df = pd.DataFrame(test_rows)\n    if train_df.empty or test_df.empty:\n        raise ValueError(\'Train or test set ended up empty. Adjust the splitting procedure.\')\n    return train_df, test_df\n\n# Evaluation helpers: compute Recall@K and NDCG@K for ranked predictions\n\ndef recall_ndcg_at_k(preds_df, test_df, k=10):\n    # preds_df: DataFrame with columns [\'user_id\',\'item_id\',\'score\'] for all user-item candidates\n    # test_df: DataFrame with ground truth interactions (user_id,item_id) for test\n    # Build per-user ground truth set\n    test_by_user = test_df.groupby(\'user_id\')[\'item_id\'].apply(set).to_dict()\n    # Build per-user predictions top-k\n    topk = preds_df.sort_values([\'user_id\',\'score\'], ascending=[True, False]).groupby(\'user_id\').head(k)\n    topk_by_user = topk.groupby(\'user_id\')[\'item_id\'].apply(list).to_dict()\n    # Compute Recall@K and NDCG@K per user\n    recalls = []\n    ndcgs = []\n    for u, gt in test_by_user.items():\n        pred_list = topk_by_user.get(u, [])\n        hit = sum(1 for x in pred_list if x in gt)\n        rem = len(gt) if len(gt) > 0 else 1\n        recalls.append(hit / min(len(gt), k))\n        # DCG: sum over positions p of relevance(1 if item in gt else 0) / log2(p+1)\n        dcg = 0.0\n        for idx, item in enumerate(pred_list[:k], start=1):\n            rel = 1 if item in gt else 0\n            if rel:\n                dcg += 1.0 / np.log2(idx + 1)\n        idcg = sum(1.0 / np.log2(i + 1) for i in range(1, min(len(gt), k) + 1)) if len(gt) > 0 else 0.0\n        ndcgs.append(dcg / idcg if idcg > 0 else 0.0)\n    return np.mean(recalls), np.mean(ndcgs)\n\n# Try to use LensKit if available\nlenskit_available = False\ntry:\n    from lenskit.algorithms.implicit import ImplicitMF\n    from lenskit.batch import predict as lk_predict\n    lenskit_available = True\nexcept Exception:\n    lenskit_available = False\n\n# Parameters\nseeds = [0, 1, 2, 3, 4]  # multiple seeds to test\nK = 10  # cutoff for recall/ndcg\nresults = {\n    \'seeds\': [],\n    \'val_loss\': [],\n    \'recall@K\': [],\n    \'ndcg@K\': [],\n}\nexperiment_data = {\n    \'movielens_100k_seed_stability\': {\n        \'metrics\': {\'train\': [], \'val\': []},\n        \'losses\': {\'train\': [], \'val\': []},\n        \'predictions\': [],\n        \'ground_truth\': [],\n        \'seeds\': []\n    }\n}\n\n# Prepare a map of training/test data per seed\nnp.random.seed(0)\nfor seed in seeds:\n    # Split with given seed\n    train_df, test_df = train_test_split_per_user(df, seed=seed)\n    # Prepare data for lenskit: we need 0-based user/item ids and a rating value; we\'ll use 1.0 for positive interactions\n    train_df_lk = train_df[[\'user_id\',\'item_id\',\'rating\']].copy()\n    train_df_lk.rename(columns={\'user_id\':\'user\',\'item_id\':\'item\'}, inplace=True)\n    test_df_lk = test_df[[\'user_id\',\'item_id\',\'rating\']].copy()\n    test_df_lk.rename(columns={\'user_id\':\'user\',\'item_id\':\'item\'}, inplace=True)\n    # For prediction input: need a dataframe with all user-item pairs to score; we\'ll construct candidates as all items for each user in test set\n    test_candidates = test_df_lk[[\'user\',\'item\']].copy()\n    test_candidates\n\n    # Train model\n    if lenskit_available:\n        try:\n            algo = ImplicitMF()\n            # Fit on training data; if needed, convert to appropriate dtype\n            algo.fit(train_df_lk)\n            # Predict scores for test candidates\n            preds = lk_predict(algo, test_candidates.assign(score=0.0))\n            # Ensure preds has columns [\'user\',\'item\',\'score\']\n            if \'score\' not in preds.columns:\n                preds = preds.rename(columns={\'prediction\':\'score\'}) if \'prediction\' in preds.columns else preds\n            # Compute rating risk: We\'ll use the score column as prediction for the ground truth\n            pred_scores = preds[[\'user\',\'item\',\'score\']].copy()\n            # Build ground truth for recall/ndcg: use binary relevance (item in test)\n            rec, ndcg = recall_ndcg_at_k(pred_scores, test_df_lk.rename(columns={\'user\':\'user\',\'item\':\'item\'})[[\'user\',\'item\']], k=K)\n            val_loss = None  # We\'ll compute a simple surrogate below\n        except Exception as e:\n            lenskit_available = False\n            print(\'LensKit training failed for seed\', seed, \'fallback to baseline. Error:\', e)\n            algo = None\n            pred_scores = None\n            val_loss = None\n            rec, ndcg = None, None\n    if not lenskit_available:\n        # Fallback: simple baseline - predict by global item popularity from train set\n        train_items = train_df_lk[[\'user\',\'item\']].copy()\n        # compute item popularity in train\n        item_pop = train_items.groupby(\'item\').size().to_dict()\n        # score for each test candidate: popularity of the item\n        test_candidates = test_df_lk[[\'user\',\'item\']].copy()\n        test_candidates[\'score\'] = test_candidates[\'item\'].map(item_pop).fillna(0).astype(float)\n        pred_scores = test_candidates\n        # compute recall/ndcg using binary relevance on test_df_lk\n        rec, ndcg = recall_ndcg_at_k(pred_scores, test_df_lk[[\'user\',\'item\']], k=K)\n        val_loss = None\n    # Record results\n    results[\'seeds\'].append(seed)\n    results[\'val_loss\'].append(val_loss if val_loss is not None else 0.0)\n    results[\'recall@K\'].append(rec if rec is not None else 0.0)\n    results[\'ndcg@K\'].append(ndcg if ndcg is not None else 0.0)\n    experiment_data[\'movielens_100k_seed_stability\'][\'seeds\'].append(seed)\n    experiment_data[\'movielens_100k_seed_stability\'][\'val\'].append(val_loss if val_loss is not None else 0.0)\n    experiment_data[\'movielens_100k_seed_stability\'][\'metrics\'][\'val\'].append((seed, val_loss))\n    experiment_data[\'movielens_100k_seed_stability\'][\'predictions\'].append(pred_scores.values if pred_scores is not None else None)\n    experiment_data[\'movielens_100k_seed_stability\'][\'ground_truth\'].append(test_df_lk[[\'user\',\'item\']].values)\n\n# Save results\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\n# Also save a simple summary text\nsummary_path = os.path.join(working_dir, \'summary.txt\')\nwith open(summary_path, \'w\') as f:\n    for i, seed in enumerate(results[\'seeds\']):\n        f.write(f"Seed {seed}: val_loss={results[\'val_loss\'][i]:.4f}, recall@{K}={results[\'recall@K\'][i]:.4f}, ndcg@{K}={results[\'ndcg@K\'][i]:.4f}\\n")\n\nprint(\'Experiment finished. Results saved to\', working_dir)\nprint(\'Seeds tested:\', results[\'seeds\'])\nprint(\'Recall@K per seed:\', results[\'recall@K\'])\nprint(\'NDCG@K per seed:\', results[\'ndcg@K\'])\n\n```', 'Execution Output': '```\nTraceback (most recent call last):\n  File "C:\\Users\\Amine\\desktop\\MLP_AmineB99\\autoreclab\\treesearch\\interpreter.py", line 147, in _run_session\n    exec(compile(code, self.agent_file_name, "exec"), global_scope)\n  File "runfile.py", line 159, in <module>\n    rec, ndcg = recall_ndcg_at_k(pred_scores, test_df_lk[[\'user\',\'item\']], k=K)\n                ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File "runfile.py", line 62, in recall_ndcg_at_k\n    test_by_user = test_df.groupby(\'user_id\')[\'item_id\'].apply(set).to_dict()\n                   ^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File "C:\\Users\\Amine\\AppData\\Roaming\\Python\\Python311\\site-packages\\pandas\\util\\_decorators.py", line 336, in wrapper\n    return func(*args, **kwargs)\n           ^^^^^^^^^^^^^^^^^^^^^\n  File "C:\\Users\\Amine\\AppData\\Roaming\\Python\\Python311\\site-packages\\pandas\\core\\frame.py", line 10833, in groupby\n    return DataFrameGroupBy(\n           ^^^^^^^^^^^^^^^^^\n  File "C:\\Users\\Amine\\AppData\\Roaming\\Python\\Python311\\site-packages\\pandas\\core\\groupby\\groupby.py", line 1095, in __init__\n    grouper, exclusions, obj = get_grouper(\n                               ^^^^^^^^^^^^\n  File "C:\\Users\\Amine\\AppData\\Roaming\\Python\\Python311\\site-packages\\pandas\\core\\groupby\\grouper.py", line 901, in get_grouper\n    raise KeyError(gpr)\nKeyError: \'user_id\'\nExecution time: a moment seconds (time limit is an hour).\n```', 'Instructions': ['Carefully analyze the execution output for signs of bugs or failures:', '- Syntax errors, import errors, or runtime exceptions', '- Missing required outputs or metrics', '- Execution timeouts or crashes', '- Incorrect or nonsensical results', '', "If there's a bug, provide a clear summary of the issue and suggest how to fix it.", 'If the execution was successful, leave the summary empty.']}
