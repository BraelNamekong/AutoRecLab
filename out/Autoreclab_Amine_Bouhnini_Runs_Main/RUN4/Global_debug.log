h, K)\n        ndcg = ndcg_at_k(preds_df, truth, K)\n\n        print(f"Seed {seed} - Epoch {epoch}: validation_loss = {val_loss:.4f}, Recall@{K} = {recall:.4f}, NDCG@{K} = {ndcg:.4f}")\n\n        # Update experiment data structure\n        if \'movielens100k_seed_experiment\' in experiment_data:\n            experiment_data[\'movielens100k_seed_experiment\'][\'metrics\'][\'val\'].append({\'seed\': int(seed), \'epoch\': int(epoch), \'val_loss\': val_loss, \'recall\': recall, \'ndcg\': ndcg})\n            experiment_data[\'movielens100k_seed_experiment\'][\'losses\'][\'val\'].append({\'seed\': int(seed), \'epoch\': int(epoch), \'val_loss\': val_loss})\n            # store predictions and ground truth for potential later analysis\n            _ = preds_df.copy()\n            experiment_data[\'movielens100k_seed_experiment\'][\'predictions\'].append(preds_df)\n            experiment_data[\'movielens100k_seed_experiment\'][\'ground_truth\'].append(test_df[[\'user\',\'item\']].copy())\n            experiment_data[\'movielens100k_seed_experiment\'][\'per_seed\'].append({\'seed\': int(seed), \'epoch\': int(epoch)})\n\n# Save all metrics and data to a numpy file for reproducibility\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nprint(\'Experiment finished. Data saved to\', os.path.join(working_dir, \'experiment_data.npy\'))\n\n```', 'Execution Output': '```\nSeed 0 - Epoch 1: validation_loss = 0.4839, Recall@10 = 1.0000, NDCG@10 = 1.0000\nSeed 0 - Epoch 2: validation_loss = 0.4831, Recall@10 = 1.0000, NDCG@10 = 1.0000\nSeed 0 - Epoch 3: validation_loss = 0.4849, Recall@10 = 1.0000, NDCG@10 = 1.0000\nSeed 1 - Epoch 1: validation_loss = 0.4826, Recall@10 = 1.0000, NDCG@10 = 1.0000\nSeed 1 - Epoch 2: validation_loss = 0.4841, Recall@10 = 1.0000, NDCG@10 = 1.0000\nSeed 1 - Epoch 3: validation_loss = 0.4833, Recall@10 = 1.0000, NDCG@10 = 1.0000\nSeed 2 - Epoch 1: validation_loss = 0.4828, Recall@10 = 1.0000, NDCG@10 = 1.0000\nSeed 2 - Epoch 2: vali