 \'metrics_names\': [\'ndcg\', \'recall\'],\n}\n\n# 3) Data loading and preprocessing\ndef load_movielens_u_data(path, min_rating=4):\n    if not os.path.exists(path):\n        raise SystemExit(f"{path} not found. Place MovieLens100K u.data in the working directory.")\n    df = pd.read_csv(path, sep=\'\\t\', header=None, names=[\'user\', \'item\', \'rating\', \'timestamp\'], engine=\'python\')\n    df = df[df[\'rating\'] >= min_rating].copy()\n    df[\'user\'] = df[\'user\'].astype(int) - 1\n    df[\'item\'] = df[\'item\'].astype(int) - 1\n    # contiguous indices\n    user_map = {u: idx for idx, u in enumerate(sorted(df[\'user\'].unique()))}\n    item_map = {i: idx for idx, i in enumerate(sorted(df[\'item\'].unique()))}\n    df[\'user\'] = df[\'user\'].map(user_map)\n    df[\'item\'] = df[\'item\'].map(item_map)\n    n_users = int(df[\'user\'].max()) + 1\n    n_items = int(df[\'item\'].max()) + 1\n    return df, n_users, n_items\n\n# deterministic per-user train/test split (same across seeds)\ndef fixed_split_all_users(data_df, test_frac=0.2, split_seed=12345):\n    rng = np.random.default_rng(split_seed)\n    train_pairs = []\n    test_pairs = []\n    gt_per_user = {}\n    for u, group in data_df.groupby(\'user\'):\n        items = group[\'item\'].values\n        if len(items) == 0:\n            continue\n        idx = rng.permutation(len(items))\n        n_test = max(1, int(len(items) * test_frac))\n        test_items = items[idx[:n_test]]\n        train_items = items[idx[n_test:]]\n        for it in train_items:\n            train_pairs.append((int(u), int(it)))\n        for it in test_items:\n            test_pairs.append((int(u), int(it)))\n            gt_per_user.setdefault(int(u), set()).add(int(it))\n    return train_pairs, test_pairs, gt_per_user\n\n# 4) Attempt to import LensKit components (best-effort)\ntry:\n    from lenskit.datasets import Dataset\n    from lenskit.algorithms import ImplicitMF\n    # Some versions expose params names slightly differently; we\'ll adapt later\n    LENSKIT_AVAILABLE = True\nexcept Exception:\n    LENSKIT_AVAILABLE = False\n\n# 5) Helpers for evaluation metrics (per-user ranking)\n\ndef dcg_for_rankings(rankings, gt_set):\n    # rankings: list of item ids in ranked order\n    dcg = 0.0\n    for rank, it in enumerate(rankings, start=1):\n        if int(it) in gt_set:\n            dcg += 1.0 / math.log2(rank + 1)\n    # ideal DCG: best possible with len(gt_set) relevant items\n    idcg = sum(1.0 / math.log2(r + 1) for r in range(1, min(len(gt_set), len(rankings)) + 1))\n    if idcg <= 0:\n        return 0.0\n    return dcg / idcg\n\n\ndef evaluate_ranking(model, test_users, gt_per_user, n_items, top_k_list=[5,10,20]):\n    ndcg_acc = {k: 0.0 for k in top_k_list}\n    recall_acc = {k: 0.0 for k in top_k_list}\n    count = 0\n    for u in test_users:\n        gt = gt_per_user.get(int(u), set())\n        if len(gt) == 0:\n            continue\n        # Try to obtain scores for all items for user u\n        scores = None\n        try:\n            # Common API in LensKit: predict scores for all items for a user\n            scores = model.predict(u, items=np.arange(n_items))  # may raise\n        except Exception:\n            try:\n                # Alternative: model.recommend returns top-N with scores\n                recs = model.recommend(u, top_k=max(top_k_list))\n                ranked_items = [r for r in recs]\n                scores = ranked_items  # not a real score, but we can approximate\n            except Exception:\n                scores = None\n        if scores is None:\n            continue\n        # Build a ranking from scores (if we have scores vector)\n        if isinstance(scores, (list, np.ndarray)) and len(scores) == n_items:\n            ranked_items = np.argsort(np.array(scores))[::-1]\n        else:\n            # If scores is a list of item ids in ranking, convert directly\n            try:\n                ranked_items = np.array(scores, dtype=int)\n            except Exception:\n                continue\n        gt_set = set(int(x) for x in gt)\n        for k in top_k_list:\n            topk = ranked_items[:k]\n            ndcg = dcg_for_rankings(topk, gt_set)\n            recall = len([it for it in topk if int(it) in gt_set]) / float(len(gt_set))\n            ndcg_acc[k] += ndcg\n            recall_acc[k] += recall\n        count += 1\n    if count == 0:\n        return {k: {\'ndcg\': 0.0, \'recall\': 0.0} for k in top_k_list}\n    for k in top_k_list:\n        ndcg_acc[k] /= count\n        recall_acc[k] /= count\n    return {k: {\'ndcg\': ndcg_acc[k], \'recall\': recall_acc[k]} for k in top_k_list}\n\n# 6) Data loading and preprocessing\ndf, n_users, n_items = load_movielens_u_data(CONFIG[\'data_path\'], CONFIG[\'min_rating_for_interaction\'])\ntrain_pairs, test_pairs, gt_per_user = fixed_split_all_users(df, CONFIG[\'test_frac\'], CONFIG[\'split_seed\'])\n# Build a set of all items for scoring convenience\nall_items = np.arange(n_items)\n\n# 7) Run experiments across seeds with LensKit or a light fallback\nresults_rows = []\nexperiment_data = {\n    \'MovieLens100K_LensKitImplicitMF\': {\n        \'metrics\': {\'val\': []},\n        \'losses\': {\'train\': []},\n        \'predictions\': [],\n        \'ground_truth\': [],\n        \'seed\': None\n    }\n}\nstart_time = time.time()\n\nfor seed in CONFIG[\'seeds\']:\n    t0 = time.time()\n    # Fit model with LensKit if available, else raise a helpful message\n    ndcg_vals = None\n    per_seed_metrics = {}\n    if LENSKIT_AVAILABLE:\n        # Prepare LensKit training dataset\n        train_df = pd.DataFrame(train_pairs, columns=[\'user\', \'item\'])\n        # For LensKit, we need a DataFrame with \'user\', \'item\', \'rating\' or \'interaction\'\n        train_df = train_df.assign(rating=1.0)\n        try:\n            train_ds = Dataset.from_df(train_df, user_id=\'user\', item_id=\'item\', rating=\'rating\')\n        except Exception:\n            train_ds = Dataset.from_df(train_df, user_col=\'user\', item_col=\'item\', rating_col=\'rating\')\n        # Initialize ImplicitMF\n        try:\n            algo = ImplicitMF(n_factors=CONFIG[\'factors\'], epochs=CONFIG[\'epochs\'], lr=CONFIG[\'learning_rate\'], reg=CONFIG[\'reg\'])\n        except TypeError:\n            # Fallback keyword names for older/newer API\n            algo = ImplicitMF(factors=CONFIG[\'factors\'], epochs=CONFIG[\'epochs\'], learning_rate=CONFIG[\'learning_rate\'], reg=CONFIG[\'reg\'])\n        # Fit model\n        try:\n            model = algo.fit(train_ds)\n        except Exception:\n            # If simple fit interface differs, attempt to initialize with a wrapper\n            model = algo.fit(train_df)\n        # Evaluation for ranking\n        test_users = sorted(list(gt_per_user.keys()))\n        metrics = evaluate_ranking(model, test_users, gt_per_user, n_items, top_k_list=CONFIG[\'top_k\'])\n        ndcg_vals = [metrics[k][\'ndcg\'] for k in CONFIG[\'top_k\']]\n        recall_vals = [metrics[k][\'recall\'] for k in CONFIG[\'top_k\']]\n        per_seed_metrics = {\'ndcg\': ndcg_vals, \'recall\': recall_vals}\n        # For per-epoch training loss: if LensKit exposes epoch losses, we cannot guarantee; we\'ll skip realistic trace\n        train_losses = None\n    else:\n        # If LensKit is not available, gracefully skip with a warning and continue using a simple baseline (non-LensKit) for reproducibility\n        # Here we reuse the previous SGD-based simple MF as a fallback for reproducibility\n        # Use identical code as prior approach but with a fixed seed\n        np.random.seed(seed)\n        rng = np.random.default_rng(seed)\n        # Random latent factors\n        U = rng.normal(scale=0.1, size=(n_users, CONFIG[\'factors\']))\n        V = rng.normal(scale=0.1, size=(n_items, CONFIG[\'factors\']))\n        # Evaluate\n        test_users = sorted(gt_per_user.keys())\n        metrics = evaluate_ranking(type(\'MockModel\', (), {\'predict\': lambda self, u, items: np.dot(U[u], V[items].T)}), test_users, gt_per_user, n_items, top_k_list=CONFIG[\'top_k\'])\n        ndcg_vals = [metrics[k][\'ndcg\'] for k in CONFIG[\'top_k\']]\n        recall_vals = [metrics[k][\'recall\'] for k in CONFIG[\'top_k\']]\n        per_seed_metrics = {\'ndcg\': ndcg_vals, \'recall\': recall_vals}\n        train_losses = None\n    t1 = time.time()\n    results_rows.append({\n        \'run_id\': f\'run_{seed}\',\n        \'seed\': seed,\n        **{f\'ndcg@{k}\': ndcg_vals[idx] for idx, k in enumerate(CONFIG[\'top_k\'])},\n        **{f\'recall@{k}\': recall_vals[idx] for idx, k in enumerate(CONFIG[\'top_k\'])}\n    })\n    experiment_data[\'MovieLens100K_LensKitImplicitMF\'][\'seed\'] = seed\n    experiment_data[\'MovieLens100K_LensKitImplicitMF\'][\'metrics\'][\'val\'].append((seed, None))\n    experiment_data[\'MovieLens100K_LensKitImplicitMF\'][\'losses\'][\'train\'].append((seed, train_losses))\n    print(f"Seed {seed} completed in {t1-t0:.2f} sec. ndcg@5/10/20: {\', \'.join(f\'{v:.4f}\' for v in ndcg_vals)} | recall@5/10/20: {\', \'.join(f\'{v:.4f}\' for v in recall_vals)}")\n\n# 8) Persist results\nresults_df = pd.DataFrame(results_rows)\nresults_csv_path = os.path.join(working_dir, \'results.csv\')\nresults_df.to_csv(results_csv_path, index=False)\nprint(\'Saved per-run results to\', results_csv_path)\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nprint(\'Experiment data saved to\', os.path.join(working_dir, \'experiment_data.npy\'))\n\n# 9) Summary across seeds\nprint(\'\\nSeed-effect summary (mean ± std):\')\nfor k in CONFIG[\'top_k\']:\n    col = f\'ndcg@{k}\'\n    if col in results_df.columns:\n        m = results_df[col].mean()\n        s = results_df[col].std()\n        print(f\' ndcg@{k}: {m:.4f} ± {s:.4f}\')\n    colr = f\'recall@{k}\'\n    if colr in results_df.columns:\n        m = results_df[colr].mean()\n        s = results_df[colr].std()\n        print(f\' recall@{k}: {m:.4f