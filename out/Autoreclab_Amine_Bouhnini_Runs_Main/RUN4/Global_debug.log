ngs >= 4)\ncol_names = [\'user\', \'item\', \'rating\', \'timestamp\']\nif not os.path.exists(CONFIG[\'data_path\']):\n    raise SystemExit("u.data not found in current directory. Please place MovieLens100K u.data in the working directory.")\ndf = pd.read_csv(CONFIG[\'data_path\'], sep=\'\\\\t\', header=None, names=col_names, engine=\'python\')\ndf = df[df[\'rating\'] >= 4].copy()\ndf[\'user\'] = df[\'user\'].astype(int) - 1\ndf[\'item\'] = df[\'item\'].astype(int) - 1\nn_users = int(df[\'user\'].max()) + 1\nn_items = int(df[\'item\'].max()) + 1\n\n# Deterministic split helper (per-user)\ndef fixed_split_all_users(data, test_frac=0.2, split_seed=12345):\n    rng = np.random.default_rng(split_seed)\n    train_pairs = []\n    test_pairs = []\n    gt_per_user = {}\n    for u, group in data.groupby(\'user\'):\n        items = group[\'item\'].values\n        if len(items) == 0:\n            continue\n        idx = rng.permutation(len(items))\n        n_test = max(1, int(len(items) * test_frac))\n        test_items = items[idx[:n_test]]\n        train_items = items[idx[n_test:]]\n        for it in train_items:\n            train_pairs.append((int(u), int(it)))\n        for it in test_items:\n            test_pairs.append((int(u), int(it)))\n            gt_per_user.setdefault(int(u), set()).add(int(it))\n    return train_pairs, test_pairs, gt_per_user\n\ntrain_pairs, test_pairs, gt_per_user = fixed_split_all_users(df, CONFIG[\'split_frac\'], CONFIG[\'split_seed\'])\n\n# Lightweight utility: compute simple ranking metrics from latent factors\nimport math\n\ndef compute_ranking_metrics(U, V, test_users, gt_per_user, all_items, top_k_list=[5,10,20]):\n    if len(test_users) == 0:\n        return {k: {"ndcg":0.0, "recall":0.0} for k in top_k_list}\n    ndcg_acc = {k: 0.0 for k in top_k_list}\n    recall_acc = {k: 0.0 for k in top_k_list}\n    count = 0\n    for u in test_users:\n        scores = U[u] @ V.T\n        ranked_items = np.argsort(scores)[::-1]\n        gt = gt_per_user.get(int(u), set())\n        if len(gt) == 0:\n            continue\n        gt_set = set(int(x) for x in gt)\n        for k in top_k_list:\n            topk = ranked_items[:k]\n            dcg = 0.0\n            for rank, item in enumerate(topk, start=1):\n                if int(item) in gt_set:\n                    dcg += 1.0 / math.log(rank + 1, 2)\n            idcg = sum(1.0 / math.log(r + 1, 2) for r in range(1, min(k, len(gt_set)) + 1))\n            ndcg = dcg / max(idcg, 1e-12)\n            recall = len([it for it in topk if int(it) in gt_set]) / float(len(gt_set))\n            ndcg_acc[k] += ndcg\n            recall_acc[k] += recall\n        count += 1\n    if count == 0:\n        return {k: {"ndcg":0.0, "recall":0.0} for k in top_k_list}\n    for k in top_k_list:\n        ndcg_acc[k] /= count\n        recall_acc[k] /= count\n    return {k: {"ndcg": ndcg_acc[k], "recall": recall_acc[k]} for k in top_k_list}\n\n# Fallback MF trainer (SGD-based) for implicit feedback when LensKit is unavailable\ndef train_mf_sgd(n_users, n_items, train_pairs, latent_factors=20, lr=0.05, reg=0.01, epochs=5, seed=0):\n    rng = np.random.default_rng(seed)\n    U = rng.normal(scale=0.1, size=(n_users, latent_factors))\n    V = rng.normal(scale=0.1, size=(n_items, latent_factors))\n    # Build per-user item sets for fast negative sampling\n    user_pos = {u: set() for u in range(n_users)}\n    for (u, i) in train_pairs:\n        user_pos[u].add(int(i))\n    for epoch in range(epochs):\n        # shuffle train pairs each epoch\n        perm = rng.permutation(len(train_pairs))\n        for idx in perm:\n            u, i = train_pairs[idx]\n            i = int(i)\n            u = int(u)\n            # Positive update\n            Ui = U[u]\n            Vi = V[i]\n            x = Ui @ Vi\n            p = 1.0 / (1.0 + math.exp(-x))\n            grad = p - 1.0  # label y=1\n            U[u] -= lr * (grad * Vi + reg * Ui)\n            V[i] -= lr * (grad * Ui + reg * Vi)\n            # Negative sample\n            neg_pool = list(set(range(n_items)) - user_pos[u])\n            if len(neg_pool) == 0:\n                continue\n            j = rng.choice(neg_pool)\n            Vj = V[j]\n            x = U[u] @ Vj\n            p = 1.0 / (1.0 + math.exp(-x))\n            neg_grad = p  # label y=0 -> gradient uses p\n            Ui = U[u]\n            U[u] -= lr * (neg_grad * Vj + reg * Ui)\n            V[j] -= lr * (neg_grad * Ui + reg * Vj)\n    return U, V\n\n# Helper to get latent factors from LensKit path, if available\ndef attempt_lenskit(train_df, latent_factors, epochs, lr, reg, seed):\n    try:\n        from lenskit.algorithms.implicit import ImplicitMF\n        algo = ImplicitMF(features=latent_factors, iterations=epochs, learning_rate=lr, reg=reg, random_state=seed)\n        model = algo.fit(train_df)\n        # Try to extract latent factors\n        U = getattr(model, \'user_factors_\', None)\n        V = getattr(model, \'item_factors_\', None)\n        if U is None or V is None:\n            U = getattr(model, \'user_factors\', None)\n            V = getattr(model, \'item_factors\', None)\n        U = np.asarray(U)\n        V = np.asarray(V)\n        return U, V\n    except Exception:\n        return None, None\n\n# Main loop: train with different seeds using LensKit\'s ImplicitMF when available; otherwise fallback\nresults_rows = []\nexperiment_data = {\n    \'MovieLens100K_ImplicitMF\': {\n        \'metrics\': {\'val\': []},\n        \'losses\': {\'train\': []},\n        \'predictions\': [],\n        \'ground_truth\': [],\n        \'seed\': None\n    }\n}\nstart_time = time.time()\n\nfor seed in CONFIG[\'seeds\']:\n    t0 = time.time()\n    # Prepare training data for LensKit path\n    train_df = pd.DataFrame([(u, i, 1.0) for (u, i) in train_pairs], columns=[\'user\', \'item\', \'rating\'])\n    U = None\n    V = None\n    # Try LensKit path first\n    U, V = attempt_lenskit(train_df, CONFIG[\'latent_factors\'], CONFIG[\'epochs\'], CONFIG[\'lr\'], CONFIG[\'reg\'], seed)\n    using_lenskit = (U is not None and V is not None)\n    if not using_lenskit:\n        # Fallback to SGD MF\n        U, V = train_mf_sgd(n_users, n_items, train_pairs, latent_factors=CONFIG[\'latent_factors\'], lr=CONFIG[\'lr\'], reg=CONFIG[\'reg\'], epochs=CONFIG[\'epochs\'], seed=seed)\n    test_users = sorted(gt_per_user.keys())\n    metrics = compute_ranking_metrics(U, V, test_users, gt_per_user, np.arange(n_items), top_k_list=CONFIG[\'top_k\'])\n    ndcg_vals = [metrics[k][\'ndcg\'] for k in CONFIG[\'top_k\']]\n    recall_vals = [metrics[k][\'recall\'] for k in CONFIG[\'top_k\']]\n    print(\'Seed\', seed, \'final_ndcg@5/10/20:\', ndcg_vals[0], ndcg_vals[1], ndcg_vals[2], \'mode=\', \'LensKit\' if using_lenskit else \'SGD-MF\')\n    row = {\n        \'run_id\': f\'run_{seed}\',\n        \'seed\': seed,\n    }\n    for idx, k in enumerate(CONFIG[\'top_k\']):\n        row[f\'ndcg@{k}\'] = ndcg_vals[idx]\n        row[f\'recall@{k}\'] = recall_vals[idx]\n    results_rows.append(row)\n    experiment_data[\'MovieLens100K_ImplicitMF\'][\'metrics\'][\'val\'].append((seed, None))\n    experiment_data[\'MovieLens100K_ImplicitMF\'][\'losses\'][\'train\'].append((seed, None))\n    experiment_data[\'MovieLens100K_ImplicitMF\'][\'seed\'] = seed\n    t1 = time.time()\n    print(f"Seed {seed} completed in {t1-t0:.2f} sec. ")\n\n# Save results\nresults_df = pd.DataFrame(results_rows)\nresults_csv_path = os.path.join(working_dir, \'results.csv\')\nresults_df.to_csv(results_csv_path, index=False)\nprint(\'Saved per-run results to\', results_csv_path)\n\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nprint(\'Experiment data saved to\', os.path.join(working_dir, \'experiment_data.npy\'))\n\n# Summary statistics across seeds\nprint(\'\\nSeed-effect summary (mean ± std):\')\nfor k in CONFIG[\'top_k\']:\n    col_ndcg = f\'ndcg@{k}\'\n    if col_ndcg in results_df.columns:\n        m_ndcg = results_df[col_ndcg].mean()\n        s_ndcg = results_df[col_ndcg].std()\n        col_rec = f\'recall@{k}\'\n        m_rec = results_df[col_rec].mean()\n        s_rec = results_df[col_rec].std()\n        print(f\' ndcg@{k}: {m_ndcg:.4f} ± {s_ndcg:.4f} | recall@{k}: {m_rec:.4f} ± {s_rec:.4f}\')\n\n```', 'Execution Output': '```\nSeed 0 final_ndcg@5/10/20: 0.10000926582954983 0.10713783835543722 0.12498143522829852 mode= SGD-MF\nSeed 0 completed in 19.86 sec. \nSeed 1 final_ndcg@5/10/20: 0.10129571323942164 0.10760688527517394 0.127111380629249 mode= SGD-MF\nSeed 1 completed in 20.39 sec. \nSeed 2 final_ndcg@5/10/20: 0.09990409452816595 0.11363547895432989 0.1320923005319879 mode= SGD-MF\nSeed 2 completed in 20.63 sec. \nSeed 3 final_ndcg@5/10/20: 0.10116344285553353 0.11170417991301478 0.13120710177979905 mode= SGD-MF\nSeed 3 completed in 20.07 sec. \nSeed 4 final_ndcg@5/10/20: 0.1031063453624526 0.11108356149122538 0.12710772614897486 mode= SGD-MF\nSeed 4 completed in 20.30 sec. \nSaved per-run results to C:\\Users\\Amine\\Desktop\\MLP_AmineB99\\AutoRecLab\\workspace\\working\\results.csv\nExperiment data saved to C:\\Users\\Amine\\Desktop\\MLP_AmineB99\\AutoRecLab\\workspace\\working\\experiment_data.npy\n\nSeed-effect summary (mean ± std):\n ndcg@5: 0.1011 ± 0.0013 | recall@5: 0.0591 ± 0.0013\n ndcg@10: 0.1102 ± 0.0028 | recall@10: 0.1020 ± 0.0073\n ndcg@20: 0.1285 ± 0.0030 | recall@20: 0.1664 ± 0.0083\nExecution time: 2 minutes seconds (time limit is an hour).\n```', 'Instructions': ['Carefully analyze the execution output for signs of bugs or failures:', '- Syntax errors, import errors, or runtime exceptions', '- Missing required outputs or metrics', '- Execution timeouts or crashes', '- Incorrect or nonsensical results', '', "If there's a bug, provide a clear summary of the issue and suggest how to fix it.", 'If the execution was successful, leave the summary empty.']}
