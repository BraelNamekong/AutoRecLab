'Starting seed-sensitivity experiment\')\n\n# Load and preprocess data\nif not os.path.exists(DATA_FILE):\n    raise FileNotFoundError(f"Data file not found: {DATA_FILE}. Place MovieLens 100K \'u.data\' in the current directory.")\ncolnames = [\'user\', \'item\', \'rating\', \'timestamp\']\ndf = pd.read_csv(DATA_FILE, sep=\'\\t\', header=None, names=colnames, engine=\'python\')\n# Build implicit interactions: rating >= 4\nimp_df = df.loc[df[\'rating\'] >= 4, [\'user\', \'item\']].copy()\nprint(f\'Implicit interactions: {len(imp_df)}\')\nlog.info(f\'Implicit interactions: {len(imp_df)}\')\n\n# Create stable mappings (persisted IDs)\nraw_users = sorted(imp_df[\'user\'].unique())\nraw_items = sorted(imp_df[\'item\'].unique())\nuser_map = {u: idx for idx, u in enumerate(raw_users)}\nitem_map = {i: idx for idx, i in enumerate(raw_items)}\nimp_df[\'u\'] = imp_df[\'user\'].map(user_map).astype(int)\nimp_df[\'i\'] = imp_df[\'item\'].map(item_map).astype(int)\n\nn_users = len(user_map)\nn_items = len(item_map)\nprint(f\'n_users={n_users}, n_items={n_items}\')\nlog.info(f\'n_users={n_users}, n_items={n_items}\')\n\n# Persist maps\nid_maps = {\n    \'user_raw_to_internal\': user_map,\n    \'item_raw_to_internal\': item_map,\n}\nwith open(MAP_JSON, \'w\') as f:\n    json.dump(id_maps, f, indent=2)\nlog.info(\'Saved ID mappings to %s\', MAP_JSON)\n\n# Helpers: evaluate metrics for a seed\nfrom collections import defaultdict\n\n\ndef sigmoid(x):\n    return 1.0 / (1.0 + np.exp(-x))\n\n\ndef evaluate_ndcg_recall_for_seed(model, train_user_items, test_by_user, all_scores, top_k):\n    ndcg_vals = []\n    recalls = []\n    for u, test_items in test_by_user.items():\n        if len(test_items) == 0:\n            continue\n        scores = all_scores[u]  # shape (n_items,)\n        # Sort and take top_k; exclude train items by masking scores\n        train_items = train_user_items.get(u, set())\n        # mask: set score to -inf for train items\n        if train_items:\n            scores = scores.copy()\n            scores[list(train_items)] = -np.inf\n        top_idx = np.argsort(scores)[::-1][:top_k]\n        top_set = set(int(x) for x in top_idx)\n        test_set = set(int(it) for it in test_items)\n        hits = len(top_set & test_set)\n        recall = hits / max(1, len(test_set))\n        recalls.append(recall)\n        # NDCG\n        dcg = 0.0\n        for rank, idx in enumerate(top_idx, start=1):\n            if idx in test_set:\n                dcg += 1.0 / np.log2(rank + 1)\n        idcg = sum(1.0 / np.log2(r + 1) for r in range(1, min(len(test_set), top_k) + 1))\n        ndcg = dcg / idcg if idcg > 0 else 0.0\n        ndcg_vals.append(ndcg)\n    mean_ndcg = float(np.mean(ndcg_vals)) if ndcg_vals else 0.0\n    mean_recall = float(np.mean(recalls)) if recalls else 0.0\n    return mean_ndcg, mean_recall\n\n# Prepare to store results\naggregate_results = []\nper_seed_metrics = []\nstart_time = time.time()\n\n# Iterate seeds: build train/test splits per seed with per-user test allocations\nfor seed in SEEDS:\n    rng = np.random.default_rng(seed)\n    # Prepare per-user splits: for each user, sample test items\n    train_rows = []\n    test_rows = []\n    test_by_user = defaultdict(list)\n    train_user_items = defaultdict(set)\n\n    grouped = imp_df.groupby(\'u\')\n    for u, group in grouped:\n        items = group[\'i\'].values\n        if len(items) == 0:\n            continue\n        n_test_user = max(1, int(round(len(items) * TEST_FRAC)))\n        if len(items) <= n_test_user:\n            n_test_user = max(1, len(items) - 1)\n        perm = rng.permutation(len(items))\n        test_idx = perm[:n_test_user]\n        train_idx = perm[n_test_user:]\n        train_items = items[train_idx]\n        test_items = items[test_idx]\n        for it in train_items:\n            train_rows.append({\'u\': int(u), \'i\': int(it), \'rating\': 1.0})\n            train_user_items[u].add(int(it))\n        for it in test_items:\n            test_rows.append({\'u\': int(u), \'i\': int(it)})\n            test_by_user[u].append(int(it))\n\n    # If any user ends up with no train interactions, drop them from train/test later\n    train_df = pd.DataFrame(train_rows, columns=[\'u\', \'i\', \'rating\'])\n    test_df = pd.DataFrame(test_rows, columns=[\'u\', \'i\'])\n    # Map columns to align with LensKit expectations on rating\n    # Build evaluation mapping per user\n    valid_users = set(train_df[\'u\'].unique())\n    # Remove users with zero train interactions from test_by_user as well\n    test_by_user_filtered = {u: items for u, items in test_by_user.items() if u in valid_users}\n\n    # Initialize model\n    try:\n        from lenskit.algorithms.implicit import ImplicitMF\n    except Exception as e:\n        raise RuntimeError("LensKit is required for this script. Please install lenskit (pip install lenskit).")\n\n    model = ImplicitMF(n_factors=N_LATENT, epochs=EPOCHS, lr=LR, reg=REG, seed=seed)\n    # Fit model on train_df\n    train_df_full = train_df.copy()\n    train_df_full.columns = [\'user\',\'item\',\'rating\']\n    model = model.fit(train_df_full)\n\n    # Precompute scores for all user-item pairs if possible, else compute per user\n    all_scores = {}\n    for u in sorted(valid_users):\n        scores = model.score(user_id=u, items=None)  # expects vector of item scores or a mapping\n        # Fallback: if API returns dict-like\n        if isinstance(scores, dict):\n            vec = np.zeros(n_items, dtype=float)\n            for it, sc in scores.items():\n                vec[int(it)] = float(sc)\n        elif isinstance(scores, np.ndarray):\n            vec = scores\n        else:\n            # Try to get scores via predict or score\n            try:\n                vec = np.array([model.score(user_id=u, item_id=i) for i in range(n_items)], dtype=float)\n            except Exception:\n                vec = np.zeros(n_items, dtype=float)\n        all_scores[u] = vec\n\n    # For each epoch, emulate a per-epoch evaluation by training with the same seed and data; we skip epoch loop compatibility\n    # We\'ll print a single evaluation after fit\n    ndcg, recall = evaluate_ndcg_recall_for_seed(model, train_user_items, test_by_user_filtered, all_scores, TOP_K)\n    log.info(f"Seed={seed} -> NDCG@{TOP_K}={ndcg:.4f}, Recall@{TOP_K}={recall:.4f}, train_users={len(valid_users)}, test_users={len(test_by_user_filtered)}")\n    print(f\'Seed {seed}: NDCG@{TOP_K}={ndcg:.4f}, Recall@{TOP_K}={recall:.4f}\')\n    per_seed_metrics.append({\'seed\': seed, \'ndcg\': ndcg, \'recall\': recall})\n    aggregate_results.append({\'seed\': seed, \'ndcg\': ndcg, \'recall\': recall})\n\n# Save per-seed results\npd.DataFrame(per_seed_metrics).to_csv(RESULTS_CSV, index=False)\nnp.save(os.path.join(working_dir, \'experiment_seed_results.npy\'), per_seed_metrics)\nprint(\'Finished. Results saved to\', RESULTS_CSV)\nlog.info(\'Experiment complete. Results saved to %s\', RESULTS_CSV)\n\n# End of script\nprint(\'Total time: {:.2f} s\'.format(time.time() - start_time))\nlog.info(\'Total time: %.2f s\', time.time() - start_time)\n\n```', 'Execution Output': '```\nImplicit interactions: 55375\nn_users=942, n_items=1447\nTraceback (most recent call last):\n  File "C:\\Users\\Amine\\desktop\\MLP_AmineB99\\autoreclab\\treesearch\\interpreter.py", line 147, in _run_session\n    exec(compile(code, self.agent_file_name, "exec"), global_scope)\n  File "runfile.py", line 60, in <module>\n    json.dump(id_maps, f, indent=2)\n  File "C:\\Program Files\\Python311\\Lib\\json\\__init__.py", line 179, in dump\n    for chunk in iterable:\n  File "C:\\Program Files\\Python311\\Lib\\json\\encoder.py", line 432, in _iterencode\n    yield from _iterencode_dict(o, _current_indent_level)\n  File "C:\\Program Files\\Python311\\Lib\\json\\encoder.py", line 406, in _iterencode_dict\n    yield from chunks\n  File "C:\\Program Files\\Python311\\Lib\\json\\encoder.py", line 377, in _iterencode_dict\n    raise TypeE