\',\'item\',\'rating\',\'ts\'], engine=\'python\')\n    # Ensure proper dtypes\n    df[\'user\'] = df[\'user\'].astype(int)\n    df[\'item\'] = df[\'item\'].astype(int)\n    df[\'rating\'] = df[\'rating\'].astype(float)\n    df[\'ts\'] = df[\'ts\'].astype(int)\n    return df\n\n\ndef train_test_split_holdout(df: pd.DataFrame, test_per_user: int, seed: int) -> Tuple[pd.DataFrame, pd.DataFrame]:\n    rng = np.random.RandomState(seed)\n    # For each user, pick test_per_user interactions as test if possible\n    test_rows = []\n    train_rows = []\n    for user, grp in df.groupby(\'user\'):\n        if len(grp) <= test_per_user:\n            # Not enough to hold out; use all as train\n            train_rows.append(grp)\n            continue\n        idx = rng.choice(grp.index, size=min(test_per_user, len(grp)-1), replace=False)\n        test_idx = set(idx.tolist())\n        test_rows.append(grp.loc[test_idx])\n        train_rows.append(grp.drop(index=test_idx))\n    train_df = pd.concat(train_rows) if train_rows else df.iloc[0:0]\n    test_df = pd.concat(test_rows) if test_rows else df.iloc[0:0]\n    return train_df, test_df\n\n\ndef compute_rank_metrics(preds: Dict[int, List[Tuple[int, float]]], test_df: pd.DataFrame, k: int) -> Tuple[float, float]:\n    # preds: mapping from user -> list of (item, score)\n    # test_df: must contain one row per user (user, item, rating, ts)\n    # We\'ll compute NDCG@k and Recall@k for the held-out items\n    # Build per-user contribution\n    ndcg_sum = 0.0\n    recall_sum = 0.0\n    cnt = 0\n    for _, row in test_df.iterrows():\n        u = int(row[\'user\'])\n        held_item = int(row[\'item\'])\n        # get ranked list for user\n        items_scores = preds.get(u, [])\n        # sort by score desc\n        ranked = [it for it, sc in sorted(items_scores, key=lambda x: -x[1])][:k]\n        # compute rank position of held item\n        try:\n            rank_pos = ranked.index(held_item) + 1\n        except ValueError:\n       