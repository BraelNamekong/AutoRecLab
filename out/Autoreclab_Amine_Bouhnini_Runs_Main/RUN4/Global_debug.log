tems by predicted score, take top-k, compare with test items for that user\n    ndcg_total = 0.0\n    recall_total = 0.0\n    count = 0\n    test_group = test_df.groupby(\'user\')\n    pred_group = pred_df.groupby(\'user\')\n    for user, test_items in test_group:\n        true_items = set(test_items[\'item\'].tolist())\n        user_preds = pred_group.get_group(user) if user in pred_group.groups else pd.DataFrame(columns=[\'user\',\'item\',\'score\'])\n        # top-k predicted items for this user\n        if not user_preds.empty:\n            topk = user_preds.sort_values(\'score\', ascending=False).head(k)\n            pred_items = set(topk[\'item\'].tolist())\n        else:\n            pred_items = set()\n        if len(true_items) == 0:\n            continue\n        # DCG and IDCG for NDCG@K: relevance is 1 for true test items, 0 otherwise\n        hits = [1 if item in pred_items else 0 for item in true_items]\n        # sort by predictions; compute DCG for the set of true items present in the top-k order\n        # Easier approximation: compute NDCG using the binary relevance in the top-k positions\n        # We\'ll assign relevance 1 if the item is in top-k, else 0; then compute DCG with 2^rel-1\n        relevances = [1 if item in pred_items else 0 for item in true_items]\n        import math\n        # DCG: sum (2^rel -1) / log2(position+1). We\'ll place items in the order of true_items but that is not ordered by pred. Instead compute ranks\n        # Simpler: compute NDCG as (number of hits in top-k) / min(len(test_items), k)\n        hits_in_topk = sum(1 for it in true_items if it in pred_items)\n        ideal = min(len(true_items), k)\n        ndcg_user = hits_in_topk / ideal if ideal > 0 else 0.0\n        # Recall: hits / total relevant\n        recall_user = hits_in_topk / len(true_items) if len(true_items) > 0 else 0.0\n        ndcg_total += ndcg_user\n        recall_total += recall_user\n        count += 1\n    if count == 0:\n        return 0.0, 0.0\n    return ndcg_total / count, recall_total / count\n\n# If LensKit is available, define a helper to train and predict using it; otherwise return simple random baseline\ndef train_and_predict_with_lenskit(train_df, test_df, seed):\n    if not lenskit_available:\n        # Very simple baseline: score users based on their own history: popular items scoring for each user not in test\n        # Build a naive predictor: for each user, recommend their top-rated items from train set by average rating\n        user_groups = train_df.groupby(\'user\')\n        item_pop = train_df.groupby(\'item\')[\'rating\'].mean().fillna(0)\n        predictions = []\n        for _, row in test_df.iterrows():\n            user = int(row[\'user\'])\n            # choose top items by global popularity as a simple fallback\n            top_items = item_pop.sort_values(ascending=False).head(K).index.tolist()\n            for it in top_items:\n                predictions.append({\'user\': user, \'item\': int(it), \'score\': item_pop.get(it, 0)})\n        pred_df = pd.DataFrame(predictions)\n        return pred_df\n    # LensKit path\n    from lenskit import datasets as lens_datasets\n    from lenskit import topk as lk_topk\n    from lenskit.algorithms.implicit import ImplicitMF\n    from lenskit.batch import predict as lk_predict\n    from lenskit.batch import train as lk_train\n    from lenskit.metrics import ndcg, recall\n\n    # Build LensKit dataset objects from pandas dataframes\n    # LensKit expects 0-based user/item ids; our data is already 0-based\n    train_ds = lens_datasets.Dataset(train_df)  # hypothetical API\n    test_ds = lens_datasets.Dataset(test_df)\n    # Instantiate model\n    algo = ImplicitMF(dimensions=EMBEDDING_DIM, epochs=N_EPOCHS, random_state=seed, alpha=ALPHA)\n    # Fit model\n    model = lk_train(algo, train_ds)\n    # Predict scores for test interactions\n    preds = lk_predict(model, test_df)\n    # If preds is not a DataFrame with columns [\'user\',\'item\',\'score\'], convert accordingly\n    if isinstance(preds, pd.DataFrame):\n        pred_df = preds.rename(columns={\'prediction\': \'score\'}).copy()\n        if \'user\' not in pred_df.columns or \'item\' not in pred_df.columns:\n            # attempt to construct using test_df users/items with scores\n            pred_df = test_df[[\'user\',\'item\']].copy()\n            pred_df[\'score\'] = pred_df.apply(lambda r: 0.0, axis=1)\n        return pred_df\n    # Fallback\n    return pd.DataFrame(columns=[\'user\',\'item\',\'score\'])\n\n# Load data\nraw_df = load_raw_data(DATA_PATH)\nprint(f"Loaded {len(raw_df)} interactions from {DATA_PATH}")\nstart_time = datetime.now()\n\n# Main loop over seeds\nfor s_idx in range(N_SEEDS):\n    seed = s_idx + 100  # distinct seeds\n    np.random.seed(seed)\n\n    # Split\n    train_df, test_df = per_user_train_test_split(raw_df, TEST_FRACTION, seed)\n    if train_df.empty or test_df.empty:\n        print(f"Seed {seed}: empty train/test split, skipping.")\n        continue\n\n    # Train and predict\n    pred_df = train_and_predict_with_lenskit(train_df, test_df, seed)\n    if pred_df is None or pred_df.empty:\n        # Build a sane default: local popularity for each (user, item) pair in test_df\n        item_pop = train_df.groupby(\'item\')[\'rating\'].mean().sort_values(ascending=False)\n        top_items = item_pop.head(K).index.tolist()\n        pred_rows = []\n        for _, row in test_df.iterrows():\n            user = int(row[\'user\'])\n            for it in top_items:\n                pred_rows.append({\'user\': user, \'item\': int(it), \'score\': float(item_pop.get(it, 0))})\n        pred_df = pd.DataFrame(pred_rows)\n    # Reconcile with test_df to compute metrics\n    ndcg_val, recall_val = eval_metrics(pred_df, test_df, K)\n\n    metrics_per_seed[\'ndcg@{}\'.format(K)].append(ndcg_val)\n    metrics_per_seed[\'recall@{}\'.format(K)].append(recall_val)\n    per_seed_details.append({\n        \'seed\': seed,\n        \'nd