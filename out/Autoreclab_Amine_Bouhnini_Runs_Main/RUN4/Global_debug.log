r[\'rating\'] = 1.0\n\n    # Build lenskit dataset structures if possible\n    if ImplicitMF is not None:\n        # Try to instantiate model with seed\n        try:\n            model = ImplicitMF(n_factors=N_FACTORS, iterations=N_ITERS, seed=seed)\n        except TypeError:\n            # fallback to keyword args commonly used\n            model = ImplicitMF(n_factors=N_FACTORS, iterations=N_ITERS, random_state=seed)\n        # We need dataset interface; attempt to create a LensKit dataset from pandas\n        try:\n            from lenskit import datasets as lkds\n            train_ds = lkds.MovieLens(\'train\', train_inter)\n            test_ds = lkds.MovieLens(\'test\', test_inter)\n            # Fit model\n            model.fit(train_ds)\n            # Predict scores for all user-item pairs in test set\n            preds_by_user = {}\n            for u in test_inter[\'user\'].unique():\n                user_idx = int(u)\n                # candidates: all items\n                # Some APIs require item list; We\'ll use all items in training set as candidates\n                items_all = list(train_inter[\'item\'].unique())\n                scores = []\n                for it in items_all:\n                    # score = model.predict(user, item)\n                    score = model.predict(user_idx, int(it))\n                    scores.append((int(it), float(score)))\n                preds_by_user[user_idx] = scores\n        except Exception:\n            # If dataset API not available, fallback to simple per-user predictions using model directly if possible\n            preds_by_user = {}\n            for u in test_inter[\'user\'].unique():\n                user_idx = int(u)\n                items_all = list(train_inter[\'item\'].unique())\n                scores = []\n                for it in items_all:\n                    try:\n                        score = model.predict(user_idx, int(it))\n                    except Exception:\n                        scor