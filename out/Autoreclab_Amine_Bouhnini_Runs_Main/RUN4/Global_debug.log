user/item ids; our data is already 0-based\\n    train_ds = lens_datasets.Dataset(train_df)  # hypothetical API\\n    test_ds = lens_datasets.Dataset(test_df)\\n    # Instantiate model\\n    algo = ImplicitMF(dimensions=EMBEDDING_DIM, epochs=N_EPOCHS, random_state=seed, alpha=ALPHA)\\n    # Fit model\\n    model = lk_train(algo, train_ds)\\n    # Predict scores for test interactions\\n    preds = lk_predict(model, test_df)\\n    # If preds is not a DataFrame with columns [\'user\',\'item\',\'score\'], convert accordingly\\n    if isinstance(preds, pd.DataFrame):\\n        pred_df = preds.rename(columns={\'prediction\': \'score\'}).copy()\\n        if \'user\' not in pred_df.columns or \'item\' not in pred_df.columns:\\n            # attempt to construct using test_df users/items with scores\\n            pred_df = test_df[[\'user\',\'item\']].copy()\\n            pred_df[\'score\'] = pred_df.apply(lambda r: 0.0, axis=1)\\n        return pred_df\\n    # Fallback\\n    return pd.DataFrame(columns=[\'user\',\'item\',\'score\'])\\n\\n# Load data\\nraw_df = load_raw_data(DATA_PATH)\\nprint(f\\"Loaded {len(raw_df)} interactions from {DATA_PATH}\\")\\nstart_time = datetime.now()\\n\\n# Main loop over seeds\\nfor s_idx in range(N_SEEDS):\\n    seed = s_idx + 100  # distinct seeds\\n    np.random.seed(seed)\\n\\n    # Split\\n    train_df, test_df = per_user_train_test_split(raw_df, TEST_FRACTION, seed)\\n    if train_df.empty or test_df.empty:\\n        print(f\\"Seed {seed}: empty train/test split, skipping.\\")\\n        continue\\n\\n    # Train and predict\\n    pred_df = train_and_predict_with_lenskit(train_df, test_df, seed)\\n    if pred_df is None or pred_df.empty:\\n        # Build a sane default: local popularity for each (user, item) pair in test_df\\n        item_pop = train_df.groupby(\'item\')[\'rating\'].mean().sort_values(ascending=False)\\n        top_items = item_pop.head(K).index.tolist()\\n        pred_rows = []\\n        for _, row in test_df.iterrows()