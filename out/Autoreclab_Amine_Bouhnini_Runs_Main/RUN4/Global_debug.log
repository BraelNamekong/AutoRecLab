ment_data[\'MovieLens100K_ImplicitMF\'][\'seed\'] = seed\n    t1 = time.time()\n    print(f"Seed {seed} completed in {t1-t0:.2f} sec. ")\n\n# Save results\nresults_df = pd.DataFrame(results_rows)\nresults_csv_path = os.path.join(working_dir, \'results.csv\')\nresults_df.to_csv(results_csv_path, index=False)\nprint(\'Saved per-run results to\', results_csv_path)\n\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nprint(\'Experiment data saved to\', os.path.join(working_dir, \'experiment_data.npy\'))\n\n# Summary statistics across seeds\nprint(\'\\nSeed-effect summary (mean ± std):\')\nfor k in CONFIG[\'top_k\']:\n    col_ndcg = f\'ndcg@{k}\'\n    if col_ndcg in results_df.columns:\n        m_ndcg = results_df[col_ndcg].mean()\n        s_ndcg = results_df[col_ndcg].std()\n        col_rec = f\'recall@{k}\'\n        m_rec = results_df[col_rec].mean()\n        s_rec = results_df[col_rec].std()\n        print(f\' ndcg@{k}: {m_ndcg:.4f} ± {s_ndcg:.4f} | recall@{k}: {m_rec:.4f} ± {s_rec:.4f}\')\n\n```', 'Execution output': '```\nSeed 0 final_ndcg@5/10/20: 0.10000926582954983 0.10713783835543722 0.12498143522829852 mode= SGD-MF\nSeed 0 completed in 19.86 sec. \nSeed 1 final_ndcg@5/10/20: 0.10129571323942164 0.10760688527517394 0.127111380629249 mode= SGD-MF\nSeed 1 completed in 20.39 sec. \nSeed 2 final_ndcg@5/10/20: 0.09990409452816595 0.11363547895432989 0.1320923005319879 mode= SGD-MF\nSeed 2 completed in 20.63 sec. \nSeed 3 final_ndcg@5/10/20: 0.10116344285553353 0.11170417991301478 0.13120710177979905 mode= SGD-MF\nSeed 3 completed in 20.07 sec. \nSeed 4 final_ndcg@5/10/20: 0.1031063453624526 0.11108356149122538 0.12710772614897486 mode= SGD-MF\nSeed 4 completed in 20.30 sec. \nSaved per-run results to C:\\Users\\Amine\\Desktop\\MLP_AmineB99\\AutoRecLab\\workspace\\working\\results.csv\nExperiment data saved to C:\\Users\\Amine\\Desktop\\MLP_AmineB99\\AutoRecLab\\workspace\\working\\experiment_data.npy\n\nSeed-effect summary (mean ± std):\n 