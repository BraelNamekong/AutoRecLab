\\t\', header=None, names=colnames, engine=\'python\')\n# Keep only user-item interactions with rating > 0 (all are 1-5, but we treat as implicit presence)\ndf = df[[\'user\', \'item\']].copy()\n# Build 0-based user/item ids\nunique_users = np.sort(df[\'user\'].unique())\nunique_items = np.sort(df[\'item\'].unique())\nuser2idx = {u: i for i, u in enumerate(unique_users)}\nitem2idx = {i: j for j, i in enumerate(unique_items)}\ndf[\'u\'] = df[\'user\'].map(user2idx).astype(int)\ndf[\'i\'] = df[\'item\'].map(item2idx).astype(int)\n# Keep only valid mappings\ndf = df[[\'u\', \'i\']].dropna()\ndf[\'u\'] = df[\'u\'].astype(int)\ndf[\'i\'] = df[\'i\'].astype(int)\n\nn_users = int(df[\'u\'].max()) + 1\nn_items = int(df[\'i\'].max()) + 1\n\n# Build a ground-truth per-seed: train/test split will be created for each seed\npairs = df[[\'u\', \'i\']].values\nn_interactions = pairs.shape[0]\n\n# Experiment data container\nexperiment_data = {\n    \'MovieLens_100k_ImplicitMF_seed_sensitivity\': {\n        \'metrics\': {\'train\': [], \'val\': []},\n        \'losses\': {\'train\': [], \'val\': []},\n        \'predictions\': [],\n        \'ground_truth\': [],\n        \'seeds\': SEEDS,\n        \'params\': {\n            \'n_latent\': N_LATENT,\n            \'epochs\': EPOCHS,\n            \'lr\': LEARNING_RATE,\n            \'reg\': REG,\n            \'top_k\': TOP_K\n        }\n    }\n}\n\n# Utility to compute NDCG@K and Recall@K for implicit predictions\nfrom collections import defaultdict\n\ndef evaluate_ndcg_recall(U, V, test_by_user, all_items_scores, top_k):\n    ndcg_vals = []\n    recalls = []\n    for u, items_test in test_by_user.items():\n        if len(items_test) == 0:\n            continue\n        scores = all_items_scores[u]  # length n_items\n        # Get top-K item indices\n        topk_idx = np.argsort(scores)[::-1][:top_k]\n        topk_set = set(topk_idx.tolist())\n        test_set = set(items_test)\n        # Recall@K\n        hit_count = len(topk_set & test_set)\n        recall = hit_count / max(1, len(test_set))\n        recalls.append(recall)\n        # NDCG@K\n        dcg = 0.0\n        for rank, idx in enumerate(topk_idx, start=1):\n            if idx in test_set:\n                dcg += 1.0 / np.log2(rank + 1)\n        idcg = sum(1.0 / np.log2(r + 1) for r in range(1, min(len(test_set), top_k) + 1))\n        ndcg = dcg / idcg if idcg > 0 else 0.0\n        ndcg_vals.append(ndcg)\n    mean_ndcg = float(np.mean(ndcg_vals)) if ndcg_vals else 0.0\n    mean_recall = float(np.mean(recalls)) if recalls else 0.0\n    return mean_ndcg, mean_recall\n\n# Iterate seeds\nfor seed in SEEDS:\n    # Train/test split\n    rng = np.random.default_rng(seed)\n    idxs = np.arange(n_interactions)\n    rng.shuffle(idxs)\n    n_train = int(TRAIN_FRAC * n_interactions)\n    train_idxs = idxs[:n_train]\n    test_idxs = idxs[n_train:]\n    train_df = df.iloc[train_idxs].copy()\n    test_df = df.iloc[test_idxs].copy()\n    # Build per-user test mapping\n    test_by_user = defaultdict(list)\n    for _, row in test_df.iterrows():\n        test_by_user[int(row[\'u\'])].append(int(row[\'i\']))\n    # Initialize latent factors\n    rng_init = np.random.default_rng(seed)\n    U = rng_init.normal(scale=0.1, size=(n_users, N_LATENT))\n    V = rng_init.normal(scale=0.1, size=(n_items, N_LATENT))\n\n    train_pairs = train_df[[\'u\', \'i\']].values\n    train_pairs_list = [tuple(p) for p in train_pairs]\n\n    epoch_losses = []\n    val_ndcg_list = []\n    for epoch in range(EPOCHS):\n        # Shuffle training pairs each epoch for SGD\n        rng_epoch = np.random.default_rng(seed + epoch)\n        train_pairs_epoch = train_pairs_list.copy()\n        rng_epoch.shuffle(train_pairs_epoch)\n        # SGD updates for implicit MF with simple logistic loss on observed interactions\n        for (u, i) in train_pairs_epoch:\n            uu = U[u]\n            vi = V[i]\n            x = float(np.dot(uu, vi))\n            p = sigmoid(x)\n            g = p - 1.0  # r_ui = 1 for observed interaction\n            # Store original U[u] for Vi update as discussed\n            Uu_before = uu.copy()\n            # Gradient steps\n            U[u] -= LEARNING_RATE * (g * vi + REG * uu)\n            V[i] -= LEARNING_RATE * (g * Uu_before + REG * vi)\n        # Compute validation metrics on current epoch\'s model\n        # Precompute scores for all users and items: scores[u, i] = dot(U[u], V[i])\n        all_scores = np.dot(U, V.T)  # shape (n_users, n_items)\n        val_ndcg, val_recall = evaluate_ndcg_recall(U, V, test_by_user, all_scores, TOP_K)\n        val_loss = 1.0 - val_ndcg\n        epoch_losses.append(val_loss)\n        val_ndcg_list.append(val_ndcg)\n        print(f\'Seed {seed}, Epoch {epoch+1}, validation_loss = {val_loss:.4f}, val_ndcg={val_ndcg:.4f}, val_recall={val_recall:.4f}\')\n\n        # Update experiment data\n        experiment_data[\'MovieLens_100k_ImplicitMF_seed_sensitivity\'][\'metrics\'][\'val\'].append(val_ndcg)\n        experiment_data[\'MovieLens_100k_ImplicitMF_seed_sensitivity\'][\'losses\'][\'val\'].append(val_loss)\n\n    # After epochs, store predictions/ground_truth for this seed (optional for later analysis)\n    experiment_data[\'MovieLens_100k_ImplicitMF_seed_sensitivity\'][\'predictions\'].append(\n        {\'seed\': seed, \'n_users\': int(n_users), \'n_items\': int(n_items)}\n    )\n    experiment_data[\'MovieLens_100k_ImplicitMF_seed_sensitivity\'][\'ground_truth\'].append(\n        {\'seed\': seed, \'n_test_users\': len(test_by_user)}\n    )\n\n# Save final experiment data\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nprint(\'\\nExperiment complete. Metrics saved to\', os.path.join(working_dir, \'experiment_data.npy\'))\n\n```', 'Execution Output': '```\nSeed 0, Epoch 1, validation_loss = 0.9478, val_ndcg=0.0522, val_recall=0.0218\nSeed 0, Epoch 2, validation_loss = 0.8851, val_ndcg=0.1149, val_recall=0.0706\nSeed 0, Epoch 3, validation_loss = 0.8871, 