lenskit_available = True\nexcept Exception:\n    lenskit_available = False\n    ImplicitMF = None\n    batch = None\n\n# 1) Load data (MovieLens 100K)\ndef load_movielens100k(path):\n    ml_df = None\n    try:\n        # Try LensKit\'s loader if available\n        from lenskit.datasets import movielens as _mlmov\n        ml_df = _mlmov.load(\'100k\')\n        ml_df = ml_df.reset_index(drop=True)\n        ml_df.columns = [\'user\',\'item\',\'rating\',\'timestamp\']\n        ml_df = ml_df.astype({\'user\':\'int\',\'item\':\'int\',\'rating\':\'float\',\'timestamp\':\'int\'})\n    except Exception:\n        if os.path.exists(path):\n            ml_df = pd.read_csv(path, sep=\'\\t\', header=None, names=[\'user\',\'item\',\'rating\',\'timestamp\'], engine=\'python\')\n            ml_df = ml_df.astype({\'user\':\'int\',\'item\':\'int\',\'rating\':\'float\',\'timestamp\':\'int\'})\n        else:\n            raise FileNotFoundError("u.data not found in working directory. Place MovieLens u.data there.")\n    return ml_df\n\ndef binarize_to_implicit(df, thresh=4.0):\n    # Convert explicit ratings to implicit interactions: 1 if rating >= thresh, else 0\n    d = df.copy()\n    d[\'interaction\'] = (d[\'rating\'] >= thresh).astype(float)\n    # Keep only positive interactions for training\n    d = d[d[\'interaction\'] > 0.0].copy()\n    d = d.drop(columns=[\'rating\', \'interaction\'])  # we\'ll treat as implicit with rating=1 for LensKit\n    # rename to standard columns for LensKit: user,item,rating\n    d = d.rename(columns={\'timestamp\':\'timestamp\'})\n    d = d.assign(rating=1.0)\n    return d\n\nml_raw = load_movielens100k(DATA_FILE)\n# Ensure we have int IDs\nml_raw[\'user\'] = ml_raw[\'user\'].astype(int)\nml_raw[\'item\'] = ml_raw[\'item\'].astype(int)\nml_raw[\'rating\'] = ml_raw[\'rating\'].astype(float)\nml_raw[\'timestamp\'] = ml_raw[\'timestamp\'].astype(int)\n\n# Binarize and filter\nimplicit_df = binarize_to_implicit(ml_raw, thresh=4.0)\nif implicit_df.empty:\n    raise ValueError("No implicit interactions after binarization. Adjust threshold or data.")\n\n# 2) Internal ID mapping for reproducibility\nuser_ids = sorted(implicit_df[\'user\'].unique())\nitem_ids = sorted(implicit_df[\'item\'].unique())\nuser_map = {raw: idx for idx, raw in enumerate(user_ids)}\nitem_map = {raw: idx for idx, raw in enumerate(item_ids)}\n# Persist mappings\nwith open(os.path.join(working_dir, \'user_id_map.json\'), \'w\') as f:\n    json.dump(user_map, f)\nwith open(os.path.join(working_dir, \'item_id_map.json\'), \'w\') as f:\n    json.dump(item_map, f)\n\nimp_df = implicit_df.copy()\nimp_df[\'user\'] = imp_df[\'user\'].map(user_map)\nimp_df[\'item\'] = imp_df[\'item\'].map(item_map)\n# Drop any rows that mapped to NaN (shouldn\'t happen)\nimp_df = imp_df.dropna().astype({\'user\':\'int\',\'item\':\'int\',\'rating\':\'float\',\'timestamp\':\'int\'})\nimp_df[\'rating\'] = imp_df[\'rating\'].astype(float)\n\n# 3) Train/test split per seed (per-user holdout, 1 test interaction where possible)\nfrom collections import defaultdict\n\ndef per_user_holdout_split(df, test_per_user=1, seed=0):\n    rng = np.random.default_rng(seed)\n    train_rows = []\n    test_rows = []\n    for u, grp in df.groupby(\'user\'):\n        if len(grp) <= test_per_user:\n            continue\n        idxs = np.arange(len(grp))\n        perm = rng.permutation(len(grp))\n        test_idx = perm[:test_per_user]\n        train_mask = np.ones(len(grp), dtype=bool)\n        train_mask[test_idx] = False\n        train_rows.append(grp.iloc[train_mask])\n        test_rows.append(grp.iloc[test_idx])\n    if not train_rows:\n        # Fallback: 80/20 split if too few interactions per user\n        train_df = df.sample(frac=0.8, random_state=seed)\n        test_df = df.drop(train_df.index)\n        return train_df, test_df\n    train_df = pd.concat(train_rows, ignore_index=True)\n    test_df = pd.concat(test_rows, ignore_index=True)\n    return train_df, test_df\n\n# 4) Training and evaluation\nseeds = SEEDS\nseed_results = []\naggregate_metric = []\nfor seed in seeds:\n    train_df, test_df = per_user_holdout_split(imp_df, test_per_user=1, seed=seed)\n    if len(train_df) == 0 or len(test_df) == 0:\n        print(f"Seed {seed}: insufficient data after split, skipping.")\n        continue\n\n    # Initialize algorithm\n    algo = None\n    if lenskit_available:\n        # Try to construct ImplicitMF with several compatible signatures\n        try:\n            algo = ImplicitMF(rank=RANK, iterations=MAX_EPOCHS, seed=seed, alpha=ALPHA, lambda_=LAMBDA)\n        except TypeError:\n            try:\n                algo = ImplicitMF(rank=RANK, iterations=MAX_EPOCHS, seed=seed, alpha=ALPHA)\n            except TypeError:\n                algo = ImplicitMF(rank=RANK, iterations=MAX_EPOCHS, seed=seed)\n    else:\n        algo = None\n\n    if lenskit_available and algo is not None:\n        # LensKit expects a DataFrame with user,item,rating (and optional timestamp)\n        train_src = train_df.copy()\n        if \'rating\' not in train_src.columns:\n            train_src[\'rating\'] = 1.0\n        # Fit model\n        try:\n            algo = algo.fit(train_src)\n        except Exception as e:\n            print(f"Seed {seed}: training failed: {e}")\n            continue\n    # Evaluation: for each user in test, build candidate items (not seen in train)\n    users = sorted(test_df[\'user\'].unique())\n    total_recall = 0\n    total_ndcg = 0.0\n    total_users = 0\n    per_user_scores = []\n    for u in users:\n        train_items = set(train_df[train_df[\'user\'] == u][\'item\'].tolist())\n        all_items = set(imp_df[\'item\'].unique())\n        candidates = sorted(list(all_items - train_items))\n        if len(candidates) == 0:\n            continue\n        pairs = pd.DataFrame({\'user\': [u]*len(candidates), \'item\': candidates})\n        if lenskit_available and batch is not None and algo is not None:\n            try:\n                preds = batch.predict(algo, pairs)\n                if \'score\' in preds.columns:\n                    scored = preds.sort_values(\'score\', ascending=False)\n                    topN = scored.head(N_TOP)[\'item\'].values\n                else:\n                    scored = preds.sort_values(\'prediction\', ascending=False)\n                    topN = scored.head(N_TOP)[\'item\'].values\n            except Exception:\n                # fallback random\n                rs = np.random.default_rng(seed)\n                scores = rs.random(len(candidates))\n                topN = [candidates[i] for i in np.argsort(-scores)[:N_TOP]]\n        else:\n            rs = np.random.default_rng(seed)\n            scores = rs.random(len(candidates))\n            topN = [candidates[i] for i in np.argsort(-scores)[:N_TOP]]\n        truth_items = test_df[test_df[\'user\'] == u][\'item\'].values\n        truth = int(truth_items[0]) if len(truth_items) > 0 else None\n        if truth is None:\n            continue\n        hit = int(truth in topN)\n        total_recall += hit\n        if truth in topN:\n            rank = int(np.where(topN == truth)[0][0]) + 1\n            ndcg = 1.0 / np.log2(rank + 1)\n        else:\n            ndcg = 0.0\n        total_ndcg += ndcg\n        total_users += 1\n        per_user_scores.append({\'user\': int(u), \'topN\': topN, \'truth\': int(truth), \'hit\': hit, \'ndcg\': ndcg})\n    if total_users == 0:\n        print(f"Seed {seed}: no evaluable users in test set, skipping metrics.")\n        continue\n    recall_at_n = total_recall / total_users\n    ndcg_at_n = total_ndcg / total_users\n\n    # Lightweight validation loss (RMSE-like) on test interactions\n    rmse = float(\'nan\')\n    if lenskit_available and algo is not None:\n        try:\n            test_pairs = test_df[[\'user\',\'item\']].copy()\n            preds_test = batch.predict(algo, test_pairs)\n            if \'score\' in preds_test.columns:\n                scores = preds_test[\'score\'].values\n            else:\n                scores = preds_test[\'prediction\'].values\n            # ground truth is 1.0 for all test interactions in implicit setup\n            true_vals = np.ones_like(scores)\n            rmse = float(np.sqrt(((scores - true_vals) ** 2).mean()))\n        except Exception:\n            rmse = float(\'nan\')\n\n    seed_results.append({\'seed\': seed, \'recall_at_n\': recall_at_n, \'ndcg_at_n\': ndcg_at_n, \'rmse\': rmse})\n    print(f"Seed {seed}: val_loss_rmse={rmse if not np.isnan(rmse) else \'nan\'}, recall@{N_TOP}={recall_at_n:.4f}, ndcg@{N_TOP}={ndcg_at_n:.4f}")\n\n# Final aggregation and saving\nresults_df = pd.DataFrame(seed_results)\nmean_recall = results_df[\'recall_at_n\'].mean() if not results_df.empty else float(\'nan\')\nstd_recall = results_df[\'recall_at_n\'].std() if not results_df.empty else float(\'nan\')\nmean_ndcg = results_df[\'ndcg_at_n\'].mean() if not results_df.empty else float(\'nan\')\nstd_ndcg = results_df[\'ndcg_at_n\'].std() if not results_df.empty else float(\'nan\')\n\nsummary = {\n    \'dataset\': \'movielens_implicitmf_seed_variation\',\n    \'n_top\': N_TOP,\n    \'rank\': RANK,\n    \'epochs\': MAX_EPOCHS,\n    \'seeds\': len(seed_results),\n    \'mean_recall\': float(mean_recall),\n    \'std_recall\': float(std_recall),\n    \'mean_ndcg\': float(mean_ndcg),\n    \'std_ndcg\': float(std_ndcg),\n    \'timestamp\': datetime.now().isoformat()\n}\n\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), {\n    \'summary\': summary,\n    \'per_seed\': seed_results,\n    \'mappings\': {\n        \'user_map\': user_map,\n        \'item_map\': item_map\n    }\n})\n\n# Save per-seed results CSV for easy inspection\npd.DataFrame(seed_results).to_csv(os.path.join(working_dir, \'seed_results.csv\'), index=False)\nprint(\'Experiment complete. Results saved to\', os.path.join(working_dir, \'experiment_data.npy\'))\nprint(\'Per-seed results written to\', os.path.join(working_dir, \'seed_results.csv