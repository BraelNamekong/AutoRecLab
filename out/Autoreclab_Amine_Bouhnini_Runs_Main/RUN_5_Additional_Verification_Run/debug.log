_path)\\n    candidates.extend([\\n        os.path.join(os.getcwd(), \'u.data\'),\\n        os.path.join(working_dir, \'u.data\'),\\n        os.path.join(os.path.dirname(os.getcwd()), \'u.data\'),\\n    ])\\n    for p in candidates:\\n        if p and os.path.exists(p):\\n            return os.path.abspath(p)\\n    search_roots = [os.getcwd(), working_dir, os.path.dirname(os.getcwd())]\\n    seen = set()\\n    for root in search_roots:\\n        root = os.path.abspath(root)\\n        if root in seen or not os.path.isdir(root):\\n            continue\\n        seen.add(root)\\n        for dirpath, _, filenames in os.walk(root):\\n            if \'u.data\' in filenames:\\n                return os.path.join(dirpath, \'u.data\')\\n    raise FileNotFoundError(\\n        \'MovieLens data file not found. Checked current directory, working directory, parent directory, \'\\n        \'and recursively searched these locations. Optionally set MOVIELENS_U_DATA to the file path.\'\\n    )\\n\\n\\nratings_path = find_ratings_file()\\nprint(f\'Using ratings file: {ratings_path}\')\\n\\ncols = [\'user\', \'item\', \'rating\', \'timestamp\']\\nratings = pd.read_csv(ratings_path, sep=\'\\\\t\', names=cols, engine=\'python\')\\nratings = ratings[[\'user\', \'item\', \'rating\', \'timestamp\']].copy()\\nratings[\'user\'] = ratings[\'user\'].astype(np.int64)\\nratings[\'item\'] = ratings[\'item\'].astype(np.int64)\\nratings[\'rating\'] = ratings[\'rating\'].astype(float).clip(lower=0.0)\\n\\nsplit_rng = np.random.RandomState(2024)\\nmask = split_rng.rand(len(ratings)) < 0.8\\ntrain = ratings.loc[mask, [\'user\', \'item\', \'rating\']].copy()\\ntest = ratings.loc[~mask, [\'user\', \'item\', \'rating\']].copy()\\n\\ntrain_users = set(train[\'user\'].unique())\\ntrain_items = set(train[\'item\'].unique())\\ntest = test[test[\'user\'].isin(train_users) & test[\'item\'].isin(train_items)].copy()\\n\\ngt = test.groupby(\'user\')[\'item\'].apply(list)\\nusers = gt.index.to_numpy()\\n\\n\\ndef 