rating\']].copy()\\nratings[\'rating\'] = (ratings[\'rating\'] >= 4).astype(np.float32)\\nratings = ratings[ratings[\'rating\'] > 0].reset_index(drop=True)\\nratings[\'rating\'] = ratings[\'rating\'].astype(np.float32)\\n\\nrng = np.random.RandomState(2024)\\nmask = rng.rand(len(ratings)) < 0.8\\ntrain = ratings[mask].copy().reset_index(drop=True)\\ntest = ratings[~mask].copy().reset_index(drop=True)\\n\\ntest_users = np.intersect1d(test[\'user\'].unique(), train[\'user\'].unique())\\ntest = test[test[\'user\'].isin(test_users)].copy().reset_index(drop=True)\\ntruth = test.groupby(\'user\')[\'item\'].apply(set).to_dict()\\nusers = sorted(truth.keys())\\nseeds = [1, 2, 3, 4, 5, 10, 20, 42, 77, 123]\\n\\n\\ndef ndcg_at_k(recs_df, truth_dict, k=10):\\n    vals = []\\n    for u, grp in recs_df.groupby(\'user\'):\\n        gt = truth_dict.get(u, set())\\n        if not gt:\\n            continue\\n        items = grp.sort_values(\'rank\')[\'item\'].head(k).tolist()\\n        dcg = sum((1.0 / np.log2(i + 2)) for i, it in enumerate(items) if it in gt)\\n        ideal = sum(1.0 / np.log2(i + 2) for i in range(min(len(gt), k)))\\n        vals.append(dcg / ideal if ideal > 0 else 0.0)\\n    return float(np.mean(vals)) if vals else 0.0\\n\\n\\ndef recall_at_k(recs_df, truth_dict, k=10):\\n    vals = []\\n    for u, grp in recs_df.groupby(\'user\'):\\n        gt = truth_dict.get(u, set())\\n        if not gt:\\n            continue\\n        items = set(grp.sort_values(\'rank\')[\'item\'].head(k).tolist())\\n        vals.append(len(items & gt) / len(gt))\\n    return float(np.mean(vals)) if vals else 0.0\\n\\n\\nresults = []\\nfor run_idx, seed in enumerate(seeds):\\n    algo = ImplicitMF(features=40, iterations=15, weight=40, progress=False, method=\'cg\', rng_spec=seed)\\n    algo.fit(train)\\n    recs = batch.recommend(algo, users, 10)\\n    ndcg = ndcg_at_k(recs, truth, 10)\\n    recall = recall_at_k(recs, truth, 10)\\n    val_loss = 1.0 - ndcg\\n    print(f\'Epoch {run_idx}: validation_loss = {val_loss:.4f}\')\\n    print(f\'Seed {seed}: NDCG@10 = {ndcg:.4f}, Recall@10 = {recall:.4f}\')\\n    results.append((seed, ndcg, recall, val_loss))\\n    experiment_data[\'ml100k_u_data\'][\'metrics\'][\'val\'].append({\'seed\': seed, \'ndcg@10\': ndcg, \'recall@10\': recall})\\n    experiment_data[\'ml100k_u_data\'][\'losses\'][\'val\'].append({\'seed\': seed, \'validation_loss\': val_loss})\\n    experiment_data[\'ml100k_u_data\'][\'predictions\'].append(recs[[\'user\', \'item\', \'score\', \'rank\']].to_dict(\'records\'))\\n    experiment_data[\'ml100k_u_data\'][\'ground_truth\'].append({str(k): sorted(list(v)) for k, v in truth.items()})\\n    experiment_data[\'ml100k_u_data\'][\'timestamps\'].append(run_idx)\\n    experiment_data[\'ml100k_u_data\'][\'seeds\'].append(seed)\\n\\nres_df = pd.DataFrame(results, columns=[\'seed\', \'ndcg@10\', \'recall@10\', \'validation_loss\'])\\nprint(\'\\\\nSummary across seeds\')\\nfor metric in [\'ndcg@10\', \'recall@10\']:\\n    vals = res_df[metric].values.astype(float)\\n    print(f\'{metric}: mean={vals.mean():.4f}, std={vals.std(ddof=1):.4f}, min={vals.min():.4f}, max={vals.max():.4f}, range={(vals.max()-vals.min()):.4f}\')\\n\\nbest_idx = res_df[\'ndcg@10\'].idxmax()\\nworst_idx = res_df[\'ndcg@10\'].idxmin()\\nprint(f\\"Best seed by NDCG@10: {int(res_df.loc[best_idx, \'seed\'])} -> {res_df.loc[best_idx, \'ndcg@10\']:.4f}\\")\\nprint(f\\"Worst seed by NDCG@10: {int(res_df.loc[worst_idx, \'seed\'])} -> {res_df.loc[worst_idx, \'ndcg@10\']:.4f}\\")\\n\\nimportance_msg = \'important\' if (res_df[\'ndcg@10\'].max() - res_df[\'ndcg@10\'].min()) >= 0.01 or (res_df[\'recall@10\'].max() - res_df[\'recall@10\'].min()) >= 0.01 else \'less critical\'\\nprint(f\'Seed reporting appears {importance_msg} for this setup based on observed metric ranges.\')\\n\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\\nnp.save(os.path.join(working_dir, \'seed_results.npy\'), res_df.to_records(index=False))\\nnp.save(os.path.join(working_dir, \'ndcg_values.npy\'), res_df[\'ndcg@10\'].values)\\nnp.save(os.path.join(working_dir, \'recall_values.npy\'), res_df[\'recall@10\'].values)\\nnp.save(os.path.join(working_dir, \'validation_loss_values.npy\'), res_df[\'validation_loss\'].values)\\nnp.save(os.path.join(working_dir, \'seeds.npy\'), res_df[\'seed\'].values)\\nnp.save(os.path.join(working_dir, \'train_test_sizes.npy\'), np.array([len(train), len(test), len(users)], dtype=np.int64))\\n\\nsummary = {\\n    \'ndcg_mean\': float(res_df[\'ndcg@10\'].mean()),\\n    \'ndcg_std\': float(res_df[\'ndcg@10\'].std(ddof=1)),\\n    \'ndcg_min\': float(res_df[\'ndcg@10\'].min()),\\n    \'ndcg_max\': float(res_df[\'ndcg@10\'].max()),\\n    \'ndcg_range\': float(res_df[\'ndcg@10\'].max() - res_df[\'ndcg@10\'].min()),\\n    \'recall_mean\': float(res_df[\'recall@10\'].mean()),\\n    \'recall_std\': float(res_df[\'recall@10\'].std(ddof=1)),\\n    \'recall_min\': float(res_df[\'recall@10\'].min()),\\n    \'recall_max\': float(res_df[\'recall@10\'].max()),\\n    \'recall_range\': float(res_df[\'recall@10\'].max() - res_df[\'recall@10\'].min())\\n}\\nnp.save(os.path.join(working_dir, \'summary_stats.npy\'), summary)\\n\\nif HAS_MPL:\\n    plt.figure(figsize=(8, 4))\\n    plt.plot(res_df[\'seed\'], res_df[\'ndcg@10\'], marker=\'o\', label=\'NDCG@10\')\\n    plt.plot(res_df[\'seed\'], res_df[\'recall@10\'], marker=\'s\', label=\'Recall@10\')\\n    plt.xlabel(\'Random seed\')\\n    plt.ylabel(\'Metric value\')\\n    plt.title(\'Metric variation across ImplicitMF seeds on ML100K\')\\n    plt.legend()\\n    plt.tight_layout()\\n    plt.savefig(os.path.join(working_dir, \'ml100k_seed_metric_lines.png\'), dpi=150)\\n    plt.close()\\n\\n    plt.figure(figsize=(8, 4))\\n    plt.subplot(1, 2, 1)\\n    plt.hist(res_df[\'ndcg@10\'], bins=min(8, len(res_df)), edgecolor=\'black\')\\n    plt.xlabel(\'NDCG@10\')\\n    plt.ylabel(\'Frequency\')\\n    plt.title(\'NDCG@10 distribution\')\\n    plt.