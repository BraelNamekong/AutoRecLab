\n\nratings_path = os.path.join(os.getcwd(), \'u.data\')\nif not os.path.exists(ratings_path):\n    raise FileNotFoundError(f\'MovieLens data file not found: {ratings_path}\')\n\ncols = [\'user\', \'item\', \'rating\', \'timestamp\']\nratings = pd.read_csv(ratings_path, sep=\'\\t\', names=cols, engine=\'python\')\nratings = ratings[[\'user\', \'item\', \'rating\', \'timestamp\']].copy()\nratings[\'user\'] = ratings[\'user\'].astype(np.int64)\nratings[\'item\'] = ratings[\'item\'].astype(np.int64)\nratings[\'rating\'] = ratings[\'rating\'].astype(float)\nratings[\'rating\'] = ratings[\'rating\'].clip(lower=0.0)\n\nsplit_rng = np.random.RandomState(2024)\nmask = split_rng.rand(len(ratings)) < 0.8\ntrain = ratings.loc[mask, [\'user\', \'item\', \'rating\']].copy()\ntest = ratings.loc[~mask, [\'user\', \'item\', \'rating\']].copy()\n\ntrain_users = set(train[\'user\'].unique())\ntrain_items = set(train[\'item\'].unique())\ntest = test[test[\'user\'].isin(train_users) & test[\'item\'].isin(train_items)].copy()\n\ngt = test.groupby(\'user\')[\'item\'].apply(list)\nusers = gt.index.to_numpy()\n\n\ndef recall_at_k(recs, truth, k=10):\n    rec_map = recs.groupby(\'user\')[\'item\'].apply(list) if len(recs) else pd.Series(dtype=object)\n    vals = []\n    for u, items in truth.items():\n        rel = set(items)\n        if not rel:\n            continue\n        pred = rec_map.get(u, [])[:k]\n        hit = sum(1 for i in pred if i in rel)\n        vals.append(hit / min(k, len(rel)))\n    return float(np.mean(vals)) if vals else 0.0\n\n\ndef ndcg_at_k(recs, truth, k=10):\n    rec_map = recs.groupby(\'user\')[\'item\'].apply(list) if len(recs) else pd.Series(dtype=object)\n    vals = []\n    for u, items in truth.items():\n        rel = set(items)\n        if not rel:\n            continue\n        pred = rec_map.get(u, [])[:k]\n        dcg = sum((1.0 / np.log2(rank + 1)) for rank, item in enumerate(pred, start=1) if item in rel)\n        ideal_hits = min(k, len(rel))\n        idcg = sum(1.0 / np.log2(r + 1) for r in range(1, ideal_hits + 1))\n        vals.append(dcg / idcg if idcg > 0 else 0.0)\n    return float(np.mean(vals)) if vals else 0.0\n\n\ndef interaction_mse(algo, df):\n    sample = df[[\'user\', \'item\']].copy()\n    preds = batch.predict(algo, sample)\n    if \'prediction\' not in preds.columns or len(preds) == 0:\n        return np.nan\n    pred = preds[\'prediction\'].to_numpy(dtype=float)\n    pred = np.nan_to_num(pred, nan=0.0, posinf=0.0, neginf=0.0)\n    true = np.ones_like(pred)\n    return float(np.mean((true - pred) ** 2))\n\n\nseeds = [1, 2, 3, 4, 5, 10, 20, 42, 77, 99]\nall_results = []\n\nfor run_idx, seed in enumerate(seeds, start=1):\n    algo = ImplicitMF(features=30, iterations=15, weight=40, progress=False, method=\'cg\', rng_spec=seed)\n    algo.fit(train[[\'user\', \'item\', \'rating\']])\n    recs = batch.recommend(algo, users, 10)\n    recs = recs[recs[\'user\'].isin(gt.index)].copy()\n\n    rec10 = recall_at_k(recs, gt, k=10)\n    ndcg10 = ndcg_at_k(recs, gt, k=10)\n    train_loss = interaction_mse(algo, train[[\'user\', \'item\', \'rating\']])\n    val_loss = interaction_mse(algo, test[[\'user\', \'item\', \'rating\']])\n\n    print(f\'Epoch {run_idx}: validation_loss = {val_loss:.4f}\')\n    print(f\'seed={seed} Recall@10={rec10:.4f} nDCG@10={ndcg10:.4f} train_loss={train_loss:.4f} val_loss={val_loss:.4f}\')\n\n    all_results.append({\n        \'seed\': seed,\n        \'Recall@10\': rec10,\n        \'nDCG@10\': ndcg10,\n        \'train_loss\': train_loss,\n        \'val_loss\': val_loss\n    })\n    experiment_data[\'ml100k_u_data\'][\'metrics\'][\'train\'].append({\n        \'epoch\': run_idx,\n        \'seed\': seed,\n        \'proxy_train_recall\': rec10,\n        \'proxy_train_ndcg\': ndcg10\n    })\n    experiment_data[\'ml100k_u_data\'][\'metrics\'][\'val\'].append({\n        \'epoch\': run_idx,\n        \'seed\': seed,\n        \'recall@10\': rec10,\n        \'ndcg@10\': ndcg10\n    })\n    experiment_data[\'ml100k_u_data\'][\'losses\'][\'train\'].append({\'epoch\': run_idx, \'seed\': seed, \'loss\': train_loss})\n    experiment_data[\'ml100k_u_data\'][\'losses\'][\'val\'].append({\'epoch\': run_idx, \'seed\': seed, \'loss\': val_loss})\n    experiment_data[\'ml100k_u_data\'][\'predictions\'].append(recs[[\'user\', \'item\', \'rank\']].to_dict(\'records\'))\n    experiment_data[\'ml100k_u_data\'][\'ground_truth\'].append(gt.to_dict())\n    experiment_data[\'ml100k_u_data\'][\'seeds\'].append(seed)\n    experiment_data[\'ml100k_u_data\'][\'timestamps\'].append(run_idx)\n\nresults = pd.DataFrame(all_results)\nprint(\'\\nPer-seed results:\')\nprint(results.to_string(index=False))\n\nsummary_rows = []\nfor metric in [\'Recall@10\', \'nDCG@10\']:\n    vals = results[metric].to_numpy(dtype=float)\n    mean = float(np.mean(vals))\n    std = float(np.std(vals, ddof=1)) if len(vals) > 1 else 0.0\n    cv = float(std / mean) if mean != 0 else np.nan\n    summary_rows.append({\n        \'metric\': metric,\n        \'mean\': mean,\n        \'std\': std,\n        \'min\': float(np.min(vals)),\n        \'max\': float(np.max(vals)),\n        \'cv\': cv\n    })\nsummary = pd.DataFrame(summary_rows)\nprint(\'\\nVariability summary across seeds:\')\nprint(summary.to_string(index=False))\n\nseed_importance_lines = []\nfor _, row in summary.iterrows():\n    spread = row[\'max\'] - row[\'min\']\n    seed_importance_lines.append(\n        f"{row[\'metric\']}: mean={row[\'mean\']:.4f}, std={row[\'std\']:.4f}, min={row[\'min\']:.4f}, max={row[\'max\']:.4f}, range={spread:.4f}, cv={row[\'cv\']:.4f}"\n    )\nanalysis_text = (\n    \'Seed sensitivity analysis on MovieLens100K with a fixed 80/20 split and repeated LensKit ImplicitMF training. \' +\n    \'If variability (std/range/CV) is non-trivial relative to mean performance, random seeds should be reported.\\n\' +\n    \'\\n\'.join(seed_importance_lines)\n)\nprint(\'\\n\' + analysis_text)\n\nnp.save(os.path.join(working_dir, \'ml100k_seed_results.npy\'), results.to_dict(\'records\'))\nnp.save(os.path.join(working_dir, \'ml100k_seed_summary.npy\'), summary.to_dict(\'records\'))\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\nnp.save(os.path.join(working_dir, \'ml100k_ground_truth.npy\'), gt.to_dict())\nwith open(os.path.join(working_dir, \'ml100k_seed_analysis.txt\'), \'w\', encoding=\'utf-8\') as f:\n    f.write(analysis_text + \'\\n\')\n\nif HAS_MPL:\n    x = np.arange(len(results))\n    fig, axes = plt.subplots(1, 2, figsize=(10, 4))\n    axes[0].plot(x, results[\'Recall@10\'].values, marker=\'o\')\n    axes[0].set_xticks(x)\n    axes[0].set_xticklabels(results[\'seed\'].astype(str).tolist(), rotation=45)\n    axes[0].set_title(\'Recall@10 across seeds\')\n    axes[0].set_xlabel(\'Seed\')\n    axes[0].set_ylabel(\'Recall@10\')\n    axes[0].grid(True, alpha=0.3)\n\n    axes[1].plot(x, results[\'nDCG@10\'].values, marker=\'o\', color=\'tab:orange\')\n    axes[1].set_xticks(x)\n    axes[1].set_xticklabels(results[\'seed\'].astype(str).tolist(), rotation=45)\n    axes[1].set_title(\'nDCG@10 across seeds\')\n    axes[1].set_xlabel(\'Seed\')\n    axes[1].set_ylabel(\'nDCG@10\')\n    axes[1].grid(True, alpha=0.3)\n\n    plt.tight_layout()\n    plt.savefig(os.path.join(working_dir, \'ml100k_seed_metric_lines.png\'), dpi=150)\n    plt.close(fig)\n\n    fig, ax = plt.subplots(figsize=(6, 4))\n    ax.boxplot([results[\'Recall@10\'].values, results[\'nDCG@10\'].values], labels=[\'Recall@10\', \'nDCG@10\'])\n    ax.set_title(\'Metric variability over random seeds\')\n    ax.grid(True, axis=\'y\', alpha=0.3)\n    plt.tight_layout()\n    plt.savefig(os.path.join(working_dir, \'ml100k_seed_metric_boxplot.png\'), dpi=150)\n    plt.close(fig)\nelse:\n    print(\'Plot files were not created because matplotlib is unavailable.\')\n\n```', 'Execution output': '```\nmatplotlib is not available; skipping plot generation.\nTraceback (most recent call last):\n  File "runfile.py", lin