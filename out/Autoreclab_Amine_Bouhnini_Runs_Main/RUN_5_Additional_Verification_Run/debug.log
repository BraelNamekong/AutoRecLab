 the fixed data split only\\nDATA_SPLIT_SEED = 2024\\nMODEL_SEEDS = [1, 7, 13, 21, 42, 77, 100, 123, 256, 999]\\nTOPK = 10\\nTEST_FRAC = 0.2\\n\\nexperiment_data = {\\n    \'ml100k_u_data\': {\\n        \'metrics\': {\'train\': [], \'val\': []},\\n        \'losses\': {\'train\': [], \'val\': []},\\n        \'predictions\': [],\\n        \'ground_truth\': [],\\n        \'seeds\': [],\\n        \'timestamps\': []\\n    }\\n}\\n\\ndef load_data(path):\\n    cols = [\'user\', \'item\', \'rating\', \'timestamp\']\\n    df = pd.read_csv(path, sep=\'\\\\t\', names=cols, engine=\'python\')\\n    return df\\n\\ndef make_fixed_split(df, test_frac=0.2, seed=2024):\\n    rng = np.random.RandomState(seed)\\n    test_idx = []\\n    for u, udf in df.groupby(\'user\'):\\n        n = len(udf)\\n        n_test = max(1, int(round(n * test_frac)))\\n        chosen = rng.choice(udf.index.values, size=min(n_test, n), replace=False)\\n        test_idx.extend(chosen.tolist())\\n    test = df.loc[sorted(test_idx)].copy()\\n    train = df.drop(index=test.index).copy()\\n    return train, test\\n\\ndef to_implicit(df):\\n    out = df[[\'user\', \'item\']].copy()\\n    out[\'rating\'] = 1.0  # normalized implicit signal\\n    return out\\n\\ndef evaluate_run(recs, test_df, k=10):\\n    truth = test_df.groupby(\'user\')[\'item\'].apply(set).to_dict()\\n    recs_by_user = recs.groupby(\'user\')[\'item\'].apply(list).to_dict()\\n    ndcgs, recalls = [], []\\n    for user, gt_items in truth.items():\\n        ranked = recs_by_user.get(user, [])[:k]\\n        if len(gt_items) == 0:\\n            continue\\n        hits = np.array([1 if item in gt_items else 0 for item in ranked], dtype=float)\\n        if hits.size == 0:\\n            ndcg = 0.0\\n            recall = 0.0\\n        else:\\n            discounts = 1.0 / np.log2(np.arange(2, hits.size + 2))\\n            dcg = float((hits * discounts).sum())\\n            ideal_len = min(len(gt_items), k)\\n            idcg = float((np.ones(ideal_len) * (1.0 / np.log2(np.arange(2, ideal_len + 2)))).sum())\\n            ndcg = dcg / idcg if idcg > 0 else 0.0\\n            recall = float(hits.sum()) / float(len(gt_items))\\n        ndcgs.append(ndcg)\\n        recalls.append(recall)\\n    return float(np.mean(ndcgs)), float(np.mean(recalls)), np.array(ndcgs), np.array(recalls)\\n\\n# Load and prepare data\\nratings = load_data(\'u.data\')\\ntrain_raw, test_raw = make_fixed_split(ratings, TEST_FRAC, DATA_SPLIT_SEED)\\ntrain = to_implicit(train_raw)\\ntest = to_implicit(test_raw)\\ntest_users = np.array(sorted(test[\'user\'].unique()))\\n\\nground_truth = test.groupby(\'user\')[\'item\'].apply(list).to_dict()\\nexperiment_data[\'ml100k_u_data\'][\'ground_truth\'] = np.array(\\n    [(u, np.array(items, dtype=np.int64)) for u, items in ground_truth.items()], dtype=object\\n)\\n\\nall_metrics = []\\n\\nfor epoch, seed in enumerate(MODEL_SEEDS, start=1):\\n    np.random.seed(seed)\\n    model = ImplicitMF(features=20, iterations=15, reg=0.1, weight=40, method=\'cg\', progress=None)\\n    algo = Recommender.adapt(model)\\n    algo.fit(train)\\n    recs = batch.recommend(algo, test_users, TOPK)\\n    ndcg, recall, ndcg_users, recall_users = evaluate_run(recs, test, TOPK)\\n    val_loss = 1.0 - ndcg\\n    print(f\'Epoch {epoch}: validation_loss = {val_loss:.4f}\')\\n    print(f\'  seed={seed} ndcg@{TOPK}={ndcg:.4f} recall@{TOPK}={recall:.4f}\')\\n\\n    experiment_data[\'ml100k_u_data\'][\'metrics\'][\'val\'].append({\\n        \'epoch\': epoch,\\n        \'seed\': seed,\\n        \'ndcg@10\': ndcg,\\n        \'recall@10\': recall\\n    })\\n    experiment_data[\'ml100k_u_data\'][\'losses\'][\'val\'].append({\\n        \'epoch\': epoch,\\n        \'seed\': seed,\\n        \'validation_loss\': val_loss\\n    })\\n    experiment_data[\'ml100k_u_data\'][\'predictions\'].append(\\n        recs[[\'user\', \'item\', \'score\']].to_records(index=False)\\n    )\\n    experiment_data[\'ml100k_u_data\'][\'seeds\'].append(seed)\\n    experiment_data[\'ml100k_u_data\'][\'timestamps\'].append(pd.Timestamp.now().isoformat())\\n    all_metrics.append((seed, ndcg, recall, ndcg_users, recall_users))\\n\\n# Summaries\\nseeds = np.array([x[0] for x in all_metrics])\\nndcgs = np.array([x[1] for x in all_metrics])\\nrecalls = np.array([x[2] for x in all_metrics])\\nsummary = {\\n    \'ndcg_mean\': float(ndcgs.mean()),\\n    \'ndcg_std\': float(ndcgs.std(ddof=1)) if len(ndcgs) > 1 else 0.0,\\n    \'ndcg_min\': float(ndcgs.min()),\\n    \'ndcg_max\': float(ndcgs.max()),\\n    \'recall_mean\': float(recalls.mean()),\\n    \'recall_std\': float(recalls.std(ddof=1)) if len(recalls) > 1 else 0.0,\\n    \'recall_min\': float(recalls.min()),\\n    \'recall_max\': float(recalls.max())\\n}\\n\\nprint(\'\\\\nSeed sensitivity summary:\')\\nfor k, v in summary.items():\\n    print(f\'{k}: {v:.6f}\')\\n\\n# Save plottable data\\nnp.save(os.path.join(working_dir, \'ml100k_seeds.npy\'), seeds)\\nnp.save(os.path.join(working_dir, \'ml100k_ndcg.npy\'), ndcgs)\\nnp.save(os.path.join(working_dir, \'ml100k_recall.npy\'), recalls)\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data)\\nnp.savez_compressed(os.path.join(working_dir, \'ml100k_summary.npz\'), **summary)\\n\\n# Visualizations\\nplt.figure(figsize=(8, 4))\\nplt.plot(seeds, ndcgs, marker=\'o\', label=f\'NDCG@{TOPK}\')\\nplt.plot(seeds, recalls, marker=\'s\', label=f\'Recall@{TOPK}\')\\nplt.xlabel(\'Random seed\')\\nplt.ylabel(\'Metric value\')\\nplt.title(\'Metric variation across ImplicitMF random seeds (MovieLens100K)\')\\nplt.legend()\\nplt.grid(True, alpha=0.3)\\nplt.tight_layout()\\nplt.savefig(os.path.join(working_dir, \'ml100k_seed_metric_variation.png\'), dpi=150)\\nplt.close()\\n\\nplt.figure(figsize=(8, 4))\\nplt.subplot(1, 2, 1)\\nplt.hist(ndcgs, bins=min(8, len(ndcgs)), color=\'steelblue\', alpha=0.8)\\nplt.xlabel(f\'NDCG@{TOPK}\')\\nplt.ylabel(\'Count\')\\nplt.title(\'NDCG distribution\')\\nplt.subplot(1, 2, 2)\\nplt.hist(recalls, bins=min(8, len(recalls)), color=\'darkorange\', alpha=0.8)\\nplt.xlabel(f\'Recall@{TOPK}\')\\nplt.ylabel(\'Count\')\\nplt.title(\'Recall distribution\')\\nplt.tight_layout()\\nplt.savefig(os.path.join(working_dir, \'ml100k_seed_metric_histograms.png\'), dpi=150)\\nplt.close()"}', name='return_plan_and_code'), type='function')]))[/cyan]
