from lenskit.metrics.topn import recall, ndcg\\n\\nexperiment_data = {\\n    \'movielens100k\': {\\n        \'metrics\': {\'train\': [], \'val\': []},\\n        \'losses\': {\'train\': [], \'val\': []},\\n        \'predictions\': [],\\n        \'ground_truth\': [],\\n        \'seeds\': [],\\n        \'timestamps\': []\\n    }\\n}\\n\\n# Load MovieLens100K u.data\\ncols = [\'user\', \'item\', \'rating\', \'timestamp\']\\nratings = pd.read_csv(\'u.data\', sep=\'\\\\t\', names=cols, engine=\'python\')\\nratings = ratings[[\'user\', \'item\', \'rating\', \'timestamp\']].copy()\\n\\n# Normalize to implicit feedback (binary interactions)\\nratings[\'rating\'] = 1.0\\n\\n# Fixed 80/20 split so only model seed varies\\nsplit_seed = 2024\\nrng = np.random.default_rng(split_seed)\\nmask = rng.random(len(ratings)) < 0.8\\ntrain = ratings.loc[mask, [\'user\', \'item\', \'rating\']].copy()\\ntest = ratings.loc[~mask, [\'user\', \'item\', \'rating\']].copy()\\n\\n# Keep only test users/items that are compatible with training for recommendation\\ntrain_users = set(train[\'user\'].unique())\\ntrain_items = set(train[\'item\'].unique())\\ntest = test[test[\'user\'].isin(train_users) & test[\'item\'].isin(train_items)].copy()\\n\\ntest_users = np.array(sorted(test[\'user\'].unique()))\\ntruth = test.groupby(\'user\')[\'item\'].apply(list)\\n\\nseeds = [1, 2, 3, 4, 5, 10, 20, 30, 40, 50]\\nall_metrics = []\\nall_recs = []\\n\\nfor epoch, seed in enumerate(seeds, start=1):\\n    algo = ImplicitMF(features=20, iterations=20, reg=0.1, weight=40, method=\'cg\', rng_spec=seed)\\n    algo.fit(train)\\n\\n    recs = batch.recommend(algo, test_users, 20)\\n    recs = recs.merge(truth.rename(\'truth\'), left_on=\'user\', right_index=True, how=\'inner\')\\n\\n    rla = RecListAnalysis()\\n    rla.add_metric(recall)\\n    rla.add_metric(ndcg)\\n    results = rla.compute(recs, truth)\\n\\n    mean_recall = float(results[\'recall\'].mean())\\n    mean_ndcg = float(results[\'ndcg\'].mean())\\n    val_loss = 1.0 - mean_ndcg\\n    print(f\'Epoch {epoch}: validation_loss = {val_loss:.4f}\')\\n    print(f\'Seed {seed}: Recall@20 = {mean_recall:.4f}, NDCG@20 = {mean_ndcg:.4f}\')\\n\\n    metric_row = {\\n        \'seed\': seed,\\n        \'recall@20\': mean_recall,\\n        \'ndcg@20\': mean_ndcg,\\n        \'timestamp\': epoch\\n    }\\n    all_metrics.append(metric_row)\\n    all_recs.append(recs[[\'user\', \'item\', \'rank\', \'score\']].to_records(index=False))\\n\\n    experiment_data[\'movielens100k\'][\'metrics\'][\'val\'].append(metric_row)\\n    experiment_data[\'movielens100k\'][\'losses\'][\'val\'].append({\'timestamp\': epoch, \'validation_loss\': val_loss})\\n    experiment_data[\'movielens100k\'][\'seeds\'].append(seed)\\n    experiment_data[\'movielens100k\'][\'timestamps\'].append(epoch)\\n\\nexperiment_data[\'movielens100k\'][\'ground_truth\'] = truth.to_dict()\\nexperiment_data[\'movielens100k\'][\'predictions\'] = all_recs\\n\\nmetrics_df = pd.DataFrame(all_metrics)\\nsummary = metrics_df[[\'recall@20\', \'ndcg@20\']].agg([\'mean\', \'std\', \'min\', \'max\'])\\nprint(\'\\\\nMetric summary across seeds:\')\\nprint(summary)\\n\\n# Save plottable data\\nnp.save(os.path.join(working_dir, \'experiment_data.npy\'), experiment_data, allow_pickle=True)\\nnp.save(os.path.join(working_dir, \'movielens100k_seed_metrics.npy\'), metrics_df.to_records(index=False), allow_pickle=True)\\nnp.save(os.path.join(working_dir, \'movielens100k_summary.npy\'), summary.to_numpy(), allow_pickle=True)\\n\\n# Visualization\\nfig, axes = plt.subplots(1, 2, figsize=(12, 4))\\naxes[0].plot(metrics_df[\'seed\'], metrics_df[\'recall@20\'], marker=\'o\', label=\'Recall@20\')\\naxes[0].plot(metrics_df[\'seed\'], metrics_df[\'ndcg@20\'], marker=\'s\', label=\'NDCG@20\')\\naxes[0].set_xlabel(\'Random seed\')\\naxes[0].set_ylabel(\'Metric value\')\\naxes[0].set_title(\'Metric variation across seeds\')\\naxes[0].legend()\\naxes[0].grid(True, alpha=0.3)\\n\\naxes[1].hist(metrics_df[