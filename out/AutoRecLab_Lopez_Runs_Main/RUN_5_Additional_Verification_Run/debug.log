\', \'rating\', \'timestamp\']].copy()\nratings[\'rating\'] = 1.0\n\ntrain_df, test_df = train_test_split(ratings, test_size=0.2, random_state=2024, shuffle=True)\ntrain_df = train_df[[\'user\', \'item\', \'rating\']].reset_index(drop=True)\ntest_df = test_df[[\'user\', \'item\', \'rating\']].reset_index(drop=True)\n\ntrain_users = set(train_df[\'user\'].unique())\ntrain_items = set(train_df[\'item\'].unique())\ntest_df = test_df[test_df[\'user\'].isin(train_users) & test_df[\'item\'].isin(train_items)].reset_index(drop=True)\n\ntruth = test_df.groupby(\'user\')[\'item\'].apply(set).to_dict()\nusers = sorted(truth.keys())\n\ntrain_items_by_user = train_df.groupby(\'user\')[\'item\'].apply(set).to_dict()\nall_items_sorted = np.array(sorted(train_df[\'item\'].unique()))\nitem_pos = {item: i for i, item in enumerate(all_items_sorted)}\n\n\ndef dcg(rels):\n    rels = np.asarray(rels, dtype=float)\n    if rels.size == 0:\n        return 0.0\n    return float((rels / np.log2(np.arange(2, rels.size + 2))).sum())\n\n\ndef ndcg_at_k(recommended, relevant, k=10):\n    rec_k = recommended[:k]\n    rels = [1.0 if i in relevant else 0.0 for i in rec_k]\n    idcg = dcg([1.0] * min(k, len(relevant)))\n    return 0.0 if idcg == 0 else dcg(rels) / idcg\n\n\ndef recall_at_k(recommended, relevant, k=10):\n    if not relevant:\n        return 0.0\n    return len(set(recommended[:k]) & relevant) / len(relevant)\n\n\ndef _extract_matrix(algo, names):\n    for name in names:\n        if hasattr(algo, name):\n            val = getattr(algo, name)\n            if val is not None:\n                return np.asarray(val)\n    raise AttributeError(f\'Could not find any of {names} on fitted ImplicitMF model\')\n\n\ndef _extract_index(algo, names):\n    for name in names:\n        if hasattr(algo, name):\n            idx = getattr(algo, name)\n            if idx is not None:\n                return idx\n    raise AttributeError(f\'Could not find any of {names} on fitted ImplicitMF model\')\n\n\ndef recommend_manual(algo, users, n=10):\n    user_features = _extract_matrix(algo, [\'user_features_\', \'user_features\'])\n    item_features = _extract_matrix(algo, [\'item_features_\', \'item_features\'])\n    user_index = _extract_index(algo, [\'user_index_\', \'users_\', \'user_index\'])\n    item_index = _extract_index(algo, [\'item_index_\', \'items_\', \'item_index\'])\n\n    if isinstance(item_index, pd.Index):\n        model_items = np.array(item_index)\n    else:\n        model_items = np.array(list(item_index))\n\n    rec_map = {}\n    for user in users:\n        if hasattr(user_index, \'get_loc\'):\n            try:\n                uidx = user_index.get_loc(user)\n            except KeyError:\n                rec_map[user] = []\n                continue\n        else:\n            rec_map[user] = []\n            continue\n\n        scores = item_features @ user_features[uidx]\n        seen = train_items_by_user.get(user, set())\n        if seen:\n            seen_idx = [i for i, item in enumerate(model_items) if item in seen]\n            if seen_idx:\n                scores = scores.copy()\n                scores[np.array(seen_idx, dtype=int)] = -np.inf\n\n        top_idx = np.argpartition(-scores, min(n, len(scores) - 1))[:n]\n        top_idx = top_idx[np.argsort(-scores[top_idx])]\n        rec_map[user] = model_items[top_idx].tolist()\n    return rec_map\n\n\nseeds = list(range(10))\nrun_rows, all_ndcg, all_recall = [], [], []\n\nfor run_idx, seed in enumerate(seeds, start=1):\n    algo = ImplicitMF(features=20, iterations=15, weight=40, method=\'cg\', rng_spec=seed)\n    algo.fit(train_df)\n    rec_map = recommend_manual(algo, users, n=10)\n\n    user_ndcg, user_recall = [], []\n    for u in users:\n        gt = truth[u]\n        pred = rec_map.get(u, [])\n        user_ndcg.append(ndcg_at_k(pred, gt, 10))\n        user_recall.append(recall_at_k(pred, gt, 10))\n\n    mean_ndcg = float(np.mean(user_ndcg))\n    mean_recall = float(np.mean(user_recall))\n    all_ndcg.append(mean_ndcg)\n    all_recall.append(mean_recall)\n\n    val_loss = 1.0 - mean_ndcg\n    print(f\'Epoch {run_idx}: validation_loss = {val_loss:.4f}\')\n    print(f\'Run {run_idx} seed={seed}: NDCG@10={mean_ndcg:.4f}, Recall@10={mean_recall:.4f}\')\n\n    experiment_data[\'ml100k_u_data\'][\'metrics\'][\'val\'].append({\'seed\': seed, \'ndcg@10\': mean_ndcg, \'recall@10\': mean_recall})\n    experiment_data[\'ml100k_u_data\'][\'losses\'][\'val\'].append({\'seed\': seed, \'validation_loss\': val_loss})\n    experiment_data[\'ml100k_u_data\'][\'predictions\'].append(rec_map)\n    experiment_data[\'ml100k_u_data\'][\'ground_truth\'].append(truth)\n    experiment_data[\'ml100k_u_data\'][\'timestamps\'].append(run_idx)\n    experiment_data[\'ml100k_u_data\'][\'seeds\'].append(seed)\n    run_rows.append([seed, mean_ndcg, mean_recall])\n\nrun_df = pd.DataFrame(run_rows, columns=[\'seed\', \'ndcg@10\', \'recall@10\'])\nprint(\'\\nPer-seed results:\')\nprint(run_df.to_string(index=False))\n\nsummary = pd.DataFrame({\n    \'metric\': [\'ndcg@10\', \'recall@10\'],\n    \'mean\': [np.mean(all_ndcg), np.mean(all_recall)],\n    \'std\': [np.std(all_ndcg, ddof=1), np.std(all_recall, ddof=1)],\n    \'min\': [np.min(all_ndcg), np.min(all_recall)],\n    \'max\': [np.max(all_ndcg), np.max(all_recall)],\n    \'range\': [np.max(all_ndcg) - np.min(all_ndcg), np.max(all_recall) - np.min(all_recall)],\n    \'cv_pct\': [100 * np.std(all_ndcg, ddof=1) / max(np.mean(all_ndcg), 1e-12), 100 * np.std(all_recall, ddof=1) / max(np.mean(all_recall), 1e-12)]\n})\nprint(\'\\nSeed sensitivity summary:\')\nprint(summary.to_string(index=False))\n\nbest_seed = int(run_df.sort_values(\'ndcg@10\', ascending=False).iloc[0][\'seed\'])\nworst_seed = int(run_df.sort_values(\'ndcg@10\', ascending=True).iloc[0][\'seed\'])\nprint(f"\\nNDCG@10 best seed: {best_seed}, worst seed: {worst_seed}, absolute gap: {run_df[\'ndcg@10\'].max() - run_df[\'ndcg@10\'].min():.4f}")\nprint(f"Recall@10 absolute