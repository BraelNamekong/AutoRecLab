pred = rec_map.get(u, [])\n        user_ndcg.append(ndcg_at_k(pred, gt, 10))\n        user_recall.append(recall_at_k(pred, gt, 10))\n\n    mean_ndcg = float(np.mean(user_ndcg))\n    mean_recall = float(np.mean(user_recall))\n    all_ndcg.append(mean_ndcg)\n    all_recall.append(mean_recall)\n\n    # placeholder validation-loss style logging for compatibility with requested format\n    val_loss = 1.0 - mean_ndcg\n    print(f'Epoch {run_idx}: validation_loss = {val_loss:.4f}')\n    print(f'Run {run_idx} seed={seed}: NDCG@10={mean_ndcg:.4f}, Recall@10={mean_recall:.4f}')\n\n    experiment_data['ml100k_u_data']['metrics']['val'].append({\n        'seed': seed,\n        'ndcg@10': mean_ndcg,\n        'recall@10': mean_recall\n    })\n    experiment_data['ml100k_u_data']['losses']['val'].append({\n        'seed': seed,\n        'validation_loss': val_loss\n    })\n    experiment_data['ml100k_u_data']['predictions'].append(rec_map)\n    experiment_data['ml100k_u_data']['ground_truth'].append(truth)\n    experiment_data['ml100k_u_data']['timestamps'].append(run_idx)\n    experiment_data['ml100k_u_data']['seeds'].append(seed)\n\n    run_rows.append([seed, mean_ndcg, mean_recall])\n\nrun_df = pd.DataFrame(run_rows, columns=['seed', 'ndcg@10', 'recall@10'])\nprint('\\nPer-seed results:')\nprint(run_df.to_string(index=False))\n\nsummary = pd.DataFrame({\n    'metric': ['ndcg@10', 'recall@10'],\n    'mean': [np.mean(all_ndcg), np.mean(all_recall)],\n    'std': [np.std(all_ndcg, ddof=1), np.std(all_recall, ddof=1)],\n    'min': [np.min(all_ndcg), np.min(all_recall)],\n    'max': [np.max(all_ndcg), np.max(all_recall)],\n    'range': [np.max(all_ndcg) - np.min(all_ndcg), np.max(all_recall) - np.min(all_recall)]\n})\nprint('\\nSeed sensitivity summary:')\nprint(summary.to_string(index=False))\n\n# save plottable arrays\nnp.save(os.path.join(working_dir, 'ml100k_seeds.npy'), np.array(seeds))\nnp.save(os.path.join(working_dir, 'ml100k_ndcg10.npy'), np.array(all_ndcg))\nnp.save(os.path.join(working_dir, 'ml100k_recall10.npy'), np.array(all_recall))\nnp.save(os.path.join(working_dir, 'experiment_data.npy'), experiment_data, allow_pickle=True)\nrun_df.to_csv(os.path.join(working_dir, 'ml100k_seed_results.csv'), index=False)\nsummary.to_csv(os.path.join(working_dir, 'ml100k_seed_summary.csv'), index=False)\n\n# visualization\nplt.figure(figsize=(8, 4))\nplt.plot(seeds, all_ndcg, marker='o', label='NDCG@10')\nplt.plot(seeds, all_recall, marker='s', label='Recall@10')\nplt.xlabel('Random seed')\nplt.ylabel('Metric')\nplt.title('MovieLens100K ImplicitMF sensitivity to random seed')\nplt.grid(True, alpha=0.3)\nplt.legend()\nplt.tight_layout()\nplt.savefig(os.path.join(working_dir, 'ml100k_seed_sensitivity_metrics.png'), dpi=150)\nplt.close()\n\nplt.figure(figsize=(6, 4))\nplt.boxplot([all_ndcg, all_recall], labels=['NDCG@10', 'Recall@10'])\nplt.ylabel('Metric')\nplt.title('Distribution across random seeds')\nplt.tight_layout()\nplt.savefig(os.path.join(working_dir, 'ml100k_seed_sensitivity_boxplot.png'), dpi=150)\nplt.close()\n```", 'Execution Output': '```\nNumba is using threading layer workqueue - consider TBB\nfound 1 potential runtime problems - see https://boi.st/lkpy-perf\nconcurrent.futures.process._RemoteTraceback: \n"""\nTraceback (most recent call last):\n  File "/root/.local/share/uv/python/cpython-3.11.9-linux-x86_64-gnu/lib/python3.11/concurrent/futures/process.py", line 261, in _process_worker\n    r = call_item.fn(*call_item.args, **call_item.kwargs)\n        ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File "/root/.local/share/uv/python/cpython-3.11.9-linux-x86_64-gnu/lib/python3.11/concurrent/futures/process.py", line 210, in _process_chunk\n    return [fn(*args) for args in chunk]\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File "/root/.local/share/uv/python/cpython-3.11.9-linux-x86_64-gnu/lib/python3.11/concurrent/futures/process.py", line 210, in <listcomp>\n    return [fn(*args) for args in chunk]\n            ^^^^^^^^^\n 